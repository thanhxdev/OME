<Window x:Class="WpfQuickPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        Title="OpenMedia — Quick Player (Drag &amp; Drop)" Height="600" Width="900"
        Background="#1E1E2E" AllowDrop="True" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video Preview -->
        <om:OpenMediaVideoView x:Name="VideoView" Grid.Row="0" Margin="10"/>

        <!-- Progress and Time -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtPosition" Foreground="#CDD6F4" Text="00:00:00" VerticalAlignment="Center"/>
            <Slider x:Name="SldPosition" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" Thumb.DragStarted="SldPosition_DragStarted" Thumb.DragCompleted="SldPosition_DragCompleted" ValueChanged="SldPosition_ValueChanged" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtDuration" Grid.Column="2" Foreground="#CDD6F4" Text="00:00:00" VerticalAlignment="Center"/>
        </Grid>

        <!-- Transport Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="8">
            <Button x:Name="BtnPlay" Content="▶ Play" Width="80" Margin="4" Click="BtnPlay_Click" />
            <Button x:Name="BtnPause" Content="⏸ Pause" Width="80" Margin="4" Click="BtnPause_Click" />
            <Button x:Name="BtnStop" Content="⏹ Stop" Width="80" Margin="4" Click="BtnStop_Click" />
            
            <TextBlock Foreground="#CDD6F4" Text="Vol:" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <Slider x:Name="SldVolume" Width="100" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged"/>
            
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="#CDD6F4" Margin="16,0,0,0" Text="Idle" />
        </StackPanel>
    </Grid>
</Window>
