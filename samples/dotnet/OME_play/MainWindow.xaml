<Window x:Class="OME_play.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OME_play"
        mc:Ignorable="d"
        Title="OpenMedia SDK - C#/.NET Video Player (Client-Server IPC)" 
        Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#CDD6F4">
    
    <Window.Resources>
        <!-- Modern Flat Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="BorderBrush" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#89B4FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4BEFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#F38BA8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Input Controls -->
            <RowDefinition Height="*"/>    <!-- Video Player Display -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
            <RowDefinition Height="140"/>  <!-- Console Log Terminal -->
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🎬 OpenMedia SDK Client-Server Player" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                    <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Out-of-Process DXGI KeyedMutex" FontSize="11" Foreground="#A6ADC8"/>
                    </Border>
                </StackPanel>

                <!-- Action Bar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtVideoPath" Grid.Column="0" Height="36" VerticalContentAlignment="Center"
                             Background="#11111B" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                             Padding="10,0" FontSize="13" Margin="0,0,8,0"
                             Text="C:\Users\ASUS NUC\Desktop\Code\OME\samples\test_video.mp4"/>

                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="📁 Browse..." Margin="0,0,8,0" Click="BtnBrowse_Click" Height="36"/>
                    <Button x:Name="BtnPlay" Grid.Column="2" Style="{StaticResource AccentButton}" Content="▶ Play Video" Margin="0,0,8,0" Click="BtnPlay_Click" Height="36"/>
                    <Button x:Name="BtnStop" Grid.Column="3" Style="{StaticResource DangerButton}" Content="⏹ Stop" IsEnabled="False" Margin="0,0,8,0" Click="BtnStop_Click" Height="36"/>
                    <Button x:Name="BtnScaleMode" Grid.Column="4" Content="📐 Mode: AspectFit [S]" Click="BtnScaleMode_Click" Height="36"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Video Player Surface -->
        <Border Grid.Row="1" Background="#000000" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#313244" BorderThickness="1" ClipToBounds="True">
            <Grid x:Name="VideoContainer" SizeChanged="VideoContainer_SizeChanged">
                <!-- Direct3D 11 HwndHost control -->
                <local:D3D11VideoPlayer x:Name="VideoPlayer" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Placeholder overlay before video starts -->
                <StackPanel x:Name="OverlayPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="📺" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="No Video Playing" FontSize="18" FontWeight="SemiBold" Foreground="#6C7086" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Select a video file and click Play to start Server pipeline" FontSize="12" Foreground="#585B70" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Information Bar -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="12,6" Margin="0,0,0,10" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Server: " Foreground="#A6ADC8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblServerStatus" Text="Disconnected" Foreground="#F38BA8" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Pipeline: " Foreground="#A6ADC8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblPipelineStatus" Text="Idle" Foreground="#FAB387" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="NT Handles: " Foreground="#A6ADC8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblNtHandles" Text="None" Foreground="#A6E3A1"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="Scale Mode: " Foreground="#A6ADC8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblScaleMode" Text="AspectRatioFit" Foreground="#89B4FA" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Console Log Terminal -->
        <Border Grid.Row="3" Background="#11111B" CornerRadius="6" BorderBrush="#313244" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="📋 Event Log" FontSize="12" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                    <Button Content="Clear" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Click="BtnClearLog_Click"/>
                </DockPanel>
                <TextBox x:Name="TxtLog" Grid.Row="1" Background="Transparent" Foreground="#A6E3A1" 
                         BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
