<Window x:Class="LiveStreamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        Title="OpenMedia — Live Streamer" Height="500" Width="800"
        Background="#1E1E2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <om:OpenMediaVideoView x:Name="VideoView" Grid.Row="0" Margin="10" />

        <Border Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <TextBlock Text="RTMP URL:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtRtmpUrl" Width="300" Text="rtmp://localhost/live/test" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <Button x:Name="BtnStart" Content="Start Stream" Width="100" Margin="4" Click="BtnStart_Click" />
                <Button x:Name="BtnStop" Content="Stop Stream" Width="100" Margin="4" Click="BtnStop_Click" IsEnabled="False" />
                
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
