<Window x:Class="OME_MediaPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OME_MediaPlay"
        mc:Ignorable="d"
        Title="OpenMediaSDK YouTube-Style Player" Height="600" Width="900" Background="#181818" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video Area -->
        <Border Grid.Row="0" Background="Black">
            <!-- Replace with D3DImage if using D3D11 rendering -->
            <local:D3D11VideoPlayer x:Name="VideoPlayer" />
        </Border>

        <!-- Control Bar -->
        <Grid Grid.Row="1" Background="#282828" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Play/Pause -->
                <ColumnDefinition Width="*" />    <!-- Seekbar -->
                <ColumnDefinition Width="Auto" /> <!-- Time -->
                <ColumnDefinition Width="Auto" /> <!-- Audio -->
                <ColumnDefinition Width="Auto" /> <!-- Volume Slider -->
                <ColumnDefinition Width="Auto" /> <!-- Quality -->
                <ColumnDefinition Width="Auto" /> <!-- FPS -->
                <ColumnDefinition Width="Auto" /> <!-- Load Video -->
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPlayPause" Grid.Column="0" Content="▶" Width="40" Height="40" Margin="10,0" 
                    Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="20" Click="BtnPlayPause_Click"/>

            <Slider x:Name="SeekSlider" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" 
                    Minimum="0" Maximum="100" Value="0" Thumb.DragCompleted="SeekSlider_DragCompleted" />

            <TextBlock x:Name="TxtTime" Grid.Column="2" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="10,0" />

            <Button x:Name="BtnMute" Grid.Column="3" Content="🔊" Width="40" Height="40" Margin="5,0" 
                    Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="20" Click="BtnMute_Click"/>

            <Slider x:Name="VolumeSlider" Grid.Column="4" Width="80" VerticalAlignment="Center" Margin="5,0" 
                    Minimum="0" Maximum="1" Value="1" LargeChange="0.1" SmallChange="0.05" ValueChanged="VolumeSlider_ValueChanged"/>

            <ComboBox x:Name="CmbResolution" Grid.Column="5" Width="80" VerticalAlignment="Center" Margin="10,0" 
                      SelectionChanged="CmbResolution_SelectionChanged">
                <ComboBoxItem Content="1080p" Tag="1920x1080" IsSelected="True"/>
                <ComboBoxItem Content="720p" Tag="1280x720"/>
                <ComboBoxItem Content="480p" Tag="854x480"/>
                <ComboBoxItem Content="360p" Tag="640x360"/>
            </ComboBox>

            <ComboBox x:Name="CmbFps" Grid.Column="6" Width="70" VerticalAlignment="Center" Margin="5,0"
                      SelectionChanged="CmbFps_SelectionChanged">
                <ComboBoxItem Content="60 FPS" Tag="60.0" IsSelected="True"/>
                <ComboBoxItem Content="30 FPS" Tag="30.0"/>
                <ComboBoxItem Content="24 FPS" Tag="24.0"/>
            </ComboBox>

            <Button x:Name="BtnLoad" Grid.Column="7" Content="Open" Width="60" Height="30" Margin="10,0" Click="BtnLoad_Click"/>
        </Grid>
    </Grid>
</Window>
