<Window x:Class="SRT_DECODE.FullscreenPlayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OME Fullscreen Monitor Playout"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave">
    <Grid Background="Black">
        <!-- Live Video View (Single PGM Mode) -->
        <Image x:Name="PlayoutImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>

        <!-- Multiviewer Grid (Dynamic 2x2, 3x3, etc.) -->
        <Grid x:Name="MultiviewerGrid" Margin="4" Visibility="Collapsed"/>

        <!-- Fallback / No Signal indicator -->
        <Grid x:Name="NoSignalOverlay" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📺" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtNoSignalTitle" Text="PROGRAM PLAYOUT STANDBY" FontSize="18" FontWeight="Bold" Foreground="#00FFCC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtNoSignalSubtitle" Text="Waiting for active Program or Camera video frame..." FontSize="13" Foreground="#888888" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Auto-hiding HUD Bar on Mouse Move -->
        <Border x:Name="HudBar" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="#D9121216" Padding="16,8" Opacity="0" Panel.ZIndex="10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖥️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHudTitle" Text="OME FULLSCREEN PLAYOUT" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"
        FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHudInfo" Text=" (Press ESC to exit playout)" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Content="✕ Close (ESC)" Click="BtnClose_Click" HorizontalAlignment="Right" Padding="12,4"
                        Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
