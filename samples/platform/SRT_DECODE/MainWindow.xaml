                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cam 4 Stats -->
                                        <Border Style="{StaticResource SubCardBorderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="CAM 4 (PORT 9004)" FontWeight="Bold" FontSize="11" Foreground="#00FFCC" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
