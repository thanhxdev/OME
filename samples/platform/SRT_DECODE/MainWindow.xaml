                                            <!-- ─── STRIP CAM 1 (Visible mặc định) ────────── -->
                                            <Border x:Name="StripMixerCam1" Width="48" Background="#18181E" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="4" Margin="0,0,4,0" Padding="2,4" Visibility="Visible">
