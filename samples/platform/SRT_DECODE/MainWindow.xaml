                                            </Grid>
                                        </Border>

                                        <!-- Cam 4 Row -->
                                        <Border Style="{StaticResource SubCardBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="CAM 4:" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
