                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Bind IP / Remote Host" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtIpCam2" Text="0.0.0.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Port" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtPortCam2" Text="9001" TextChanged="TxtNameOrPort_TextChanged" Tag="1"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
