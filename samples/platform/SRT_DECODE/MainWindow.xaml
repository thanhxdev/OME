<Window x:Class="SRT_DECODE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        xmlns:local="clr-namespace:SRT_DECODE"
        mc:Ignorable="d"
        Title="OME Broadcast Multi-SRT Decoder &amp; Studio Sync"
        Height="900" Width="1440"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Modern Dark Theme Control Styles -->
        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#2D2D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="BorderBrush" Value="#33333A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Toggle Switch CheckBox Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="20" Margin="0,0,8,0">
                                <Border x:Name="Track" Background="#3A3A40" CornerRadius="10" />
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#E0E0E0" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383840"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#007ACC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem High-Contrast Dark Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383842"/>
                                <Setter Property="Foreground" Value="#00FFCC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1C97EA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="3"
                        Background="#222226"
                        BorderBrush="#3E3E48"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="#CCCCCC" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2A2A30" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2A2A30" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#007ACC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Background" Value="#1A1A1E" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2D2D30" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#555555" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Dark ComboBox Style with High Contrast Custom Dropdown -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E1E22"
                                            BorderThickness="1"
                                            BorderBrush="#007ACC"
                                            CornerRadius="4"
                                            Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#2D2D32" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25252A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#00A2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202024"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Video Frame VU Meter Style -->
        <Style x:Key="VuMeterBarStyle" TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#22C55E"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Master Bar -->
            <RowDefinition Height="*"/>    <!-- Main Split Area (Multiviewer Left + Right Panels) -->
            <RowDefinition Height="Auto"/> <!-- Global Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- HEADER MASTER CONTROL BAR                                         -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1A1A1E" BorderBrush="#2A2A30" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Application Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#007ACC" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                        <TextBlock Text="SRT" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OME BROADCAST MULTI-SRT DECODER" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                        <TextBlock Text="Studio Sync • Low-Latency Playout Engine" FontSize="10.5" Foreground="#8E8E93"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Clock & Multi-Cam Sync Lock State -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Master UTC Wall Clock -->
                    <Border Background="#121214" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒 MASTER UTC:" FontSize="10.5" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtMasterUtcClock" Text="00:00:00.000" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="#00FFCC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Multi-Cam Master Sync Lock Badge -->
                    <Border x:Name="BadgeSyncLock" Background="#26262B" BorderBrush="#3D3D45" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedSyncLock" Width="8" Height="8" Fill="#888888" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtSyncLockState" Text="SYNC: FREE-RUN" FontWeight="Bold" FontSize="11" Foreground="#AAAAAA"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Action Buttons: Multiviewer Mode & Connect All -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Layout Mode Selector (View 2 cột / PGM+View) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Layout:" FontSize="11.5" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbLayoutMode" Width="210" SelectionChanged="CmbLayoutMode_SelectionChanged">
                            <ComboBoxItem Content="View (Multi-view 2 cột)" IsSelected="True"/>
                            <ComboBoxItem Content="PGM+View (PGM trên + Multi-view)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Master Ingest Start/Stop Buttons -->
                    <Button x:Name="BtnConnectAll" Content="▶ Connect All" Click="BtnConnectAll_Click" Background="#007ACC" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button x:Name="BtnDisconnectAll" Content="■ Stop All" Click="BtnDisconnectAll_Click" Background="#333338" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="11.5" Padding="10,5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT AREA (SPLIT VIEW)                                    -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/> <!-- Left: Multiviewer, Switcher, Log -->
                <ColumnDefinition Width="5"/>    <!-- Splitter -->
                <ColumnDefinition Width="3.5*"/> <!-- Right: Configuration Tabs -->
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────────────────────── -->
            <!-- LEFT COLUMN: MULTIVIEWER & VISION SWITCHER & LOGS              -->
            <!-- ────────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5.8*"/> <!-- Video Multiviewer Grid -->
                    <RowDefinition Height="Auto"/> <!-- Vision Switcher & Audio Bar -->
                    <RowDefinition Height="3.2*"/> <!-- Console Log Table -->
                </Grid.RowDefinitions>

                <!-- MULTIVIEWER CONTAINER (SCROLLABLE DYNAMIC 2-COLUMN MULTIVIEW & PGM TOP VIEW) -->
                <Border Grid.Row="0" Background="#0C0C0E" BorderBrush="#25252A" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ══ PGM MASTER PROMINENT TOP CELL (VISIBLE ONLY IN PGM+VIEW MODE) ══ -->
                            <Border x:Name="CellPgmMaster" Background="#161619" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="4" Margin="3,3,3,6" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Cell Header -->
                                    <Border Grid.Row="0" Background="#1F1F24" Padding="8,4">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#DC2626" CornerRadius="2" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="PGM ON-AIR" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF"/>
                                                </Border>
                                                <TextBlock x:Name="TxtPgmMasterTitle" Text="PROGRAM (CAM 1)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                <Ellipse x:Name="LedPgmMaster" Width="8" Height="8" Fill="#EF4444" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtPgmMasterFps" Text="1080p59.94 Master Playout" FontSize="10.5" Foreground="#888888" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- PGM Video Render Surface -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Background="#0A0A0C" MinHeight="180">
                                            <om:OpenMediaVideoView x:Name="VideoViewPgm" Stretch="Uniform"/>
                                            <Border x:Name="FallbackPgm" Background="#111116" Visibility="Visible">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="PROGRAM MASTER ON-AIR" FontWeight="Bold" FontSize="13" Foreground="#882222" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtStatusPgm" Text="Live Program Feed" FontSize="11" Foreground="#663333" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Grid.Column="1" Background="#141418" Padding="3,3" Width="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar x:Name="VuPgmTopL" Grid.Column="0" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0"/>
                                                <ProgressBar x:Name="VuPgmTopR" Grid.Column="1" Style="{StaticResource VuMeterBarStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ══ 2-COLUMN MULTIVIEWER GRID (ALWAYS 2 COLUMNS, NEVER FULL-WIDTH STRETCH) ══ -->
                            <Grid x:Name="MultiviewerContainer" MinHeight="250">
                                <!-- Dynamic RowDefinitions & 2 ColumnDefinitions generated in code -->

                                <!-- ══ CAMERA 1 CELL ════════════════════════════════ -->
                                <Border x:Name="CellCam1" Background="#161619" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="4" Margin="3" Visibility="Visible">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#1F1F24" Padding="6,3">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="TallyCam1" Background="#DC2626" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="PGM" FontWeight="Bold" FontSize="9.5" Foreground="#FFFFFF"/>
                                                    </Border>
                                                    <TextBlock x:Name="TxtHeaderCam1" Text="CAM 1 (PORT 9000)" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="LedCam1" Width="7" Height="7" Fill="#888888" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtResFpsCam1" Text="1080p59.94" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <CheckBox x:Name="ChkVuCam1" Content="VU" IsChecked="True" Click="ChkVuCam_Click" Tag="0" Foreground="#38BDF8" FontSize="9.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Bật/tắt hiển thị Audio VU Meter"/>
                                                    <CheckBox x:Name="ChkMuteCam1" Content="MUTE" IsChecked="True" Click="ChkMuteCam_Click" Tag="0" Foreground="#EF4444" FontSize="9.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Mute âm thanh luồng này"/>
                                                    <Button x:Name="BtnSoloCam1" Content="SOLO" Click="BtnSoloCam_Click" Tag="1" FontSize="9" Padding="4,1" Background="#2C2C33" Foreground="#FFFFFF" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Background="#0A0A0C" MinHeight="130">
                                            <om:OpenMediaVideoView x:Name="VideoViewCam1" Stretch="Uniform"/>
                                            <Border x:Name="FallbackCam1" Background="#111116" Visibility="Visible">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtFallbackTitleCam1" Text="CAM 1 • SRT RECEIVER" FontWeight="Bold" FontSize="12" Foreground="#555566" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtStatusCam1" Text="Standby (Listener :9000)" FontSize="10" Foreground="#444455" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="HudOverlayCam1" Background="#CC111114" CornerRadius="3" Padding="5,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="HudRttCam1" Text="RTT: 0 ms" FontSize="9.5" FontFamily="Consolas" Foreground="#00FFCC"/>
                                                    <TextBlock x:Name="HudLossCam1" Text="Loss: 0.0%" FontSize="9.5" FontFamily="Consolas" Foreground="#22C55E"/>
                                                    <TextBlock x:Name="HudBitrateCam1" Text="Bitrate: 0 kbps" FontSize="9.5" FontFamily="Consolas" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="HudDriftCam1" Text="Drift: ±0.0 ms" FontSize="9.5" FontFamily="Consolas" Foreground="#F59E0B"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Top-Right Audio VU Meter Overlay (Revealed when UNMUTED) -->
                                            <Border x:Name="OverlayAudioVuCam1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Background="#EA0C0C10" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="5,3" Visibility="Visible">
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="VU" FontSize="8" FontWeight="Bold" Foreground="#007ACC"/>
