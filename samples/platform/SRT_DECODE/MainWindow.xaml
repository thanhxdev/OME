                <!-- ══ BOTTOM LOG CONSOLE & SYSTEM STATUS ═════════════ -->
                <Border Grid.Row="2" Background="#18181C" BorderBrush="#28282E" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Log Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 BROADCAST EVENT &amp; SYNC LOG" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" Margin="0,0,10,0"/>
