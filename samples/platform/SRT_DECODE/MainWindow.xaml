                                        <Border Style="{StaticResource SubCardBorderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="CAM 3 (PORT 9003)" FontWeight="Bold" FontSize="11" Foreground="#00FFCC" Margin="0,0,0,4"/>
