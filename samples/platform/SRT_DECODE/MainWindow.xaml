                                <Button x:Name="BtnPgmCam7" Content="CAM 7" Click="BtnPgmSelect_Click" Tag="6" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed"/>
                                <Button x:Name="BtnPgmCam8" Content="CAM 8" Click="BtnPgmSelect_Click" Tag="7" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed"/>
