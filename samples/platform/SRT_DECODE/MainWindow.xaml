                                                    </Border>
                                                    <TextBlock x:Name="TxtMixerNameCam1" Text="CAM 1" FontWeight="Bold" FontSize="8.5" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Height="112">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,2,0" VerticalAlignment="Center">
                                                            <StackPanel Width="5" Margin="0,0,1,0">
                                                                <Ellipse x:Name="ClipMixerCam1_L" Width="3" Height="3" Fill="#2A2A2E" Margin="0,0,0,1" HorizontalAlignment="Center"/>
                                                                <ProgressBar x:Name="VuMixerCam1L" Orientation="Vertical" Height="100" Width="3.5" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                                            </StackPanel>
                                                            <StackPanel Width="5">
                                                                <Ellipse x:Name="ClipMixerCam1_R" Width="3" Height="3" Fill="#2A2A2E" Margin="0,0,0,1" HorizontalAlignment="Center"/>
                                                                <ProgressBar x:Name="VuMixerCam1R" Orientation="Vertical" Height="100" Width="3.5" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtGainDbCam1" Text="0.0" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="#00FFCC" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                            <Slider x:Name="FaderCam1" Orientation="Vertical" Height="96" Width="18" Minimum="-60" Maximum="12" Value="0" TickFrequency="6" IsSnapToTickEnabled="False" Tag="0" ValueChanged="MixerFader_ValueChanged" MouseDoubleClick="MixerFader_MouseDoubleClick" ToolTip="Kéo để chỉnh âm lượng (-60 đến +12 dB). Nhấp đúp reset 0 dB" Cursor="Hand"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Margin="0,2,0,2">
