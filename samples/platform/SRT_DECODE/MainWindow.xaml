                            <StackPanel>
                                <!-- Master Sync Toggle -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkMasterSync" Content="Multi-Camera Master Synchronization" Checked="ChkMasterSync_Changed" Unchecked="ChkMasterSync_Changed" Style="{StaticResource ToggleSwitchStyle}" FontWeight="Bold" FontSize="13" Foreground="#00FFCC"/>
