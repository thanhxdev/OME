            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Engine & Status Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtEngineStatus" Text="Engine: OpenMedia.Platform Active" FontSize="11" Foreground="#22C55E" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtTotalIngestBitrate" Text="Total Ingest: 0.00 Mbps" FontSize="11" Foreground="#AAAAAA" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtTotalBytesTransferred" Text="Received: 0.00 MB" FontSize="11" Foreground="#AAAAAA"/>
