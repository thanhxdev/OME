                                        <!-- Cam 1 Row -->
                                        <Border Style="{StaticResource SubCardBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="CAM 1:" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbBufferCam1" Value="100" Grid.Column="1" Height="10" Background="#141418" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtDriftValCam1" Text="Δt: +0.2 ms (Locked)" FontSize="11" Foreground="#22C55E" Grid.Column="2" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Cam 2 Row -->
                                        <Border Style="{StaticResource SubCardBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="CAM 2:" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
