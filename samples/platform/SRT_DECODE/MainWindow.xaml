                                <Border Style="{StaticResource CardBorderStyle}" Background="#1C1C22" BorderBrush="#007ACC" Margin="0,0,0,6" Padding="8,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎚️ STUDIO AUDIO MIXER" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF"/>
                                            <Border Background="#007ACC" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="2x6 CONSOLE" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2 Hàng Dải Kênh Audio Mixer (Mỗi hàng 6 khung, chiều ngang siêu gọn 48px) -->
                                <Border Background="#121216" BorderBrush="#25252C" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <StackPanel>
                                        <!-- HÀNG 1: Tối đa 6 khung Audio (Cam 1 đến Cam 6) -->
