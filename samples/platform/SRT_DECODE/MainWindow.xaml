                                            <TextBlock Text="Target Sync Window:" FontSize="11" Foreground="#9E9E9E"/>
                                            <TextBlock x:Name="TxtTargetSyncWindowVal" Text="350 ms" FontWeight="Bold" FontSize="12" Foreground="#00FFCC" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderSyncWindow" Minimum="100" Maximum="1000" Value="350" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SliderSyncWindow_ValueChanged" Margin="0,4,0,8"/>
                                        <TextBlock Text="Cửa sổ trễ đệm đồng bộ chung để khử hiện tượng lệch pha jitter mạng." FontSize="10" Foreground="#777777"/>
                                    </StackPanel>
                                </Border>

                                <!-- Real-Time Camera Drift & Compensation Matrix -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
