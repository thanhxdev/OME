                                            <TextBox x:Name="TxtBridgeHost" Text="192.168.1.150" Grid.Column="0" Margin="0,0,4,0"/>
                                            <TextBox x:Name="TxtBridgePort" Text="9100" Grid.Column="1"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbBridgeCodec" Grid.Column="0" Margin="0,0,4,0">
                                                <ComboBoxItem Content="H.264 (NVENC)" IsSelected="True"/>
                                                <ComboBoxItem Content="HEVC (H.265)"/>
                                            </ComboBox>
                                            <TextBox x:Name="TxtBridgeBitrate" Text="8000 kbps" Grid.Column="1"/>
