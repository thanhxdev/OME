<Application x:Class="SRT_DECODE.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SRT_DECODE"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Global Dark Theme Colors -->
        <SolidColorBrush x:Key="BackgroundDark" Color="#121212"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CardHeaderDark" Color="#252528"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#777777"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TallyRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="TallyGreen" Color="#16A34A"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Application.Resources>
</Application>
