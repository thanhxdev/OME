<Window x:Class="OME_PLAYOUT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OME PLAYOUT • Master Production &amp; Playout Engine"
        Height="950" Width="1600"
        MinHeight="750" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Card & Border Styles -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#131926"/>
            <Setter Property="BorderBrush" Value="#222D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#182030"/>
            <Setter Property="BorderBrush" Value="#2B3954"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#161E2E" BorderBrush="#222D42" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5,2,1.5,0"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Application Header & Global Status -->
        <Border Grid.Row="0" Background="#0F1420" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EF4444" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="ON AIR" FontWeight="Black" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="OME PLAYOUT" FontWeight="Black" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="MASTER PRODUCTION ENGINE" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center" Margin="8,2,0,0"/>
                    <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v3.0 MATRIX EDITION" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Right Clock & Source Sync Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BadgeRouterSync" Background="#0F2D1F" BorderBrush="#00E676" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotRouterSync" Width="7" Height="7" Fill="#00E676" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtRouterSyncStatus" Text="MATRIX ROUTER: SYNCED (0ms)" FontSize="10.5" FontWeight="Bold" Foreground="#00E676"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtMasterClock" Text="12:00:00:00" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: Left Monitors Area + Right Controls Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620" MinWidth="480"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- LEFT AREA: 2 BROADCAST MONITORS + STEREO AUDIO METERS  -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- TOP MONITOR: MASTER OUT (Clean/Dirty Program) -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" BorderBrush="#EF4444" BorderThickness="1.5" Margin="0,0,0,6" Padding="6">
                    <Grid>
                        <Image x:Name="ImgMasterOut" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        
                        <!-- Top Monitor Header Overlay -->
                        <Grid VerticalAlignment="Top" Margin="8">
                            <Border Background="#CC0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MASTER OUT (FINAL ON-AIR PROGRAM)" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="BadgeFailSafeStatus" Background="#2A1B1B" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock x:Name="TxtFailSafeBadge" Text="⚠️ FAIL-SAFE ACTIVE: SMPTE BARS" FontWeight="Bold" FontSize="10" Foreground="#EF4444"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- BOTTOM MONITOR: PGM IN (ROUTER FEED) -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" BorderBrush="#0284C7" Margin="0,0,0,6" Padding="6">
                    <Grid>
                        <Image x:Name="ImgPgmIn" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        <Border Background="#CC0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotPgmInStatus" Width="6" Height="6" Fill="#00E676" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPgmInStatus" Text="PGM IN (ROUTER FEED)" FontWeight="Bold" FontSize="10.5" Foreground="#38BDF8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- BOTTOM AUDIO PEAK / VU METERS -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Background="#0F1522" BorderBrush="#1E293B" Padding="8,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & dBFS values -->
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock Text="AUDIO STEREO dBFS (EBU R128)" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtMeterL" Text="L: -60.0 dBFS" FontSize="9.5" FontFamily="Consolas" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtMeterR" Text="R: -60.0 dBFS" FontSize="9.5" FontFamily="Consolas" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                <Border x:Name="BadgeClip" Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="2" Padding="4,0">
                                    <TextBlock Text="CLIP" FontWeight="Black" FontSize="9" Foreground="#EF4444"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Dual Channel Bars (L & R) -->
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Ch 1 (Left) -->
                            <ProgressBar x:Name="BarAudioL" Grid.Row="0" Height="10" Minimum="0" Maximum="1" Value="0" Background="#1A2234" Foreground="#00E676" Margin="0,1"/>

                            <!-- Ch 2 (Right) -->
                            <ProgressBar x:Name="BarAudioR" Grid.Row="1" Height="10" Minimum="0" Maximum="1" Value="0" Background="#1A2234" Foreground="#00E676" Margin="0,1"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="6" Background="#1E293B" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- RIGHT AREA: PIPELINE CONTROL TABS (6 TABS)            -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="6">
                <TabControl x:Name="TabsPlayoutControl">

                    <!-- TAB 1: MATRIX INGEST SELECTOR -->
                    <TabItem Header="1. Ingest Matrix">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SubCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🔌 IP MATRIX ROUTER INGEST SOURCE" FontWeight="Bold" FontSize="12.5" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Chọn luồng nền video chính từ bàn đạo diễn (PGM Master) hoặc bắt trực tiếp nguồn hình sạch từ 1 trong 10 luồng IP:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                        <!-- PGM Master Button -->
                                        <Button x:Name="BtnSelectPgm" Content="🔴 PORT 0: PROGRAM MASTER (Bàn cắt chuyển cảnh)" Click="BtnSelectPgm_Click"
                                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12" Padding="12,8" Margin="0,0,0,10" Cursor="Hand"/>

                                        <!-- 10 IP Buttons -->
                                        <TextBlock Text="Nguồn Trực Tiếp Từng Kênh (10 IP Feeds):" FontWeight="SemiBold" FontSize="11" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="2">
                                            <Button x:Name="BtnIso1" Tag="1" Content="IP 1 (Port 1)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso2" Tag="2" Content="IP 2 (Port 2)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso3" Tag="3" Content="IP 3 (Port 3)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso4" Tag="4" Content="IP 4 (Port 4)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso5" Tag="5" Content="IP 5 (Port 5)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso6" Tag="6" Content="IP 6 (Port 6)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso7" Tag="7" Content="IP 7 (Port 7)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso8" Tag="8" Content="IP 8 (Port 8)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso9" Tag="9" Content="IP 9 (Port 9)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnIso10" Tag="10" Content="IP 10 (Port 10)" Click="BtnSelectIso_Click" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="8,6" Margin="2" Cursor="Hand"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: BROADCAST CG (CHARACTER GENERATOR / LOGO) -->
                    <TabItem Header="2. CG">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <!-- Logo / Station Bug Layer -->
                                <Border Style="{StaticResource SubCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🏷️ BROADCAST GRAPHICS: STATION LOGO / WATERMARK (CG)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnToggleLogo" Content="DSK LOGO ON AIR 🟢" Click="BtnToggleLogo_Click" Background="#22C55E" Foreground="Black" FontWeight="Bold" FontSize="10.5" Padding="10,4" HorizontalAlignment="Right" Cursor="Hand"/>
                                        </Grid>
                                        
                                        <!-- File selection -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtLogoFile" Text="File: Default OME HD Logo" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnBrowseLogo" Grid.Column="1" Content="📁 Nạp Logo PNG..." Click="BtnBrowseLogo_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,4" FontSize="10.5" Cursor="Hand"/>
                                        </Grid>

                                        <!-- Position Presets -->
                                        <TextBlock Text="Vị trí góc phát sóng chuẩn (Corner Presets):" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="4" Margin="0,0,0,10">
                                            <Button x:Name="BtnLogoPosTr" Tag="TR" Content="Góc Trên Phải (TR)" Click="BtnLogoPos_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="6,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnLogoPosTl" Tag="TL" Content="Góc Trên Trái (TL)" Click="BtnLogoPos_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" Padding="6,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnLogoPosBr" Tag="BR" Content="Góc Dưới Phải (BR)" Click="BtnLogoPos_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" Padding="6,6" Margin="2" Cursor="Hand"/>
                                            <Button x:Name="BtnLogoPosBl" Tag="BL" Content="Góc Dưới Trái (BL)" Click="BtnLogoPos_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" Padding="6,6" Margin="2" Cursor="Hand"/>
                                        </UniformGrid>

                                        <!-- Fine Sliders -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="2">
                                                <TextBlock Text="Kích thước Logo (Scale):" FontSize="10.5" Foreground="#94A3B8"/>
                                                <Slider x:Name="SliderLogoScale" Minimum="0.3" Maximum="2.5" Value="1.0" ValueChanged="SliderLogo_ValueChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="2">
                                                <TextBlock Text="Độ trong suốt (Opacity):" FontSize="10.5" Foreground="#94A3B8"/>
                                                <Slider x:Name="SliderLogoOpacity" Minimum="0.1" Maximum="1.0" Value="0.9" ValueChanged="SliderLogo_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="2">
                                                <TextBlock Text="Dịch ngang X (Normalized X):" FontSize="10.5" Foreground="#94A3B8"/>
                                                <Slider x:Name="SliderLogoX" Minimum="0.0" Maximum="1.0" Value="0.88" ValueChanged="SliderLogoPos_ValueChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="2">
                                                <TextBlock Text="Dịch dọc Y (Normalized Y):" FontSize="10.5" Foreground="#94A3B8"/>
                                                <Slider x:Name="SliderLogoY" Minimum="0.0" Maximum="1.0" Value="0.08" ValueChanged="SliderLogoPos_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: COLOR CORRECTION & BROADCAST SCOPES -->
                    <TabItem Header="3. CCU &amp; 3D LUT">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="370" MinHeight="180"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*" MinHeight="140"/>
                            </Grid.RowDefinitions>

                            <!-- ROW 0: BROADCAST COLOR SCOPES (THANG ĐO MÀU TRUYỀN HÌNH) -->
                            <Border Grid.Row="0" Style="{StaticResource SubCardStyle}" BorderBrush="#00E5FF" Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Scope Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="📈 BỘ THANG ĐO MÀU TRUYỀN HÌNH CHUẨN (BROADCAST SCOPES)" FontWeight="Bold" FontSize="12" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                        <Border Background="#0F2D1F" BorderBrush="#00E676" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtScopeGamutStatus" Text="LEGAL (BT.709)" FontSize="9.5" FontWeight="Bold" Foreground="#00E676"/>
                                        </Border>
                                    </Grid>

                                    <!-- Scope Selector Toolbar -->
                                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,6">
                                        <Button x:Name="BtnScopeWaveform" Tag="0" Content="1. Waveform (IRE)" Click="BtnSelectScope_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="10" Padding="3,5" Margin="1" Cursor="Hand"/>
                                        <Button x:Name="BtnScopeParade" Tag="1" Content="2. RGB Parade" Click="BtnSelectScope_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" FontSize="10" Padding="3,5" Margin="1" Cursor="Hand"/>
                                        <Button x:Name="BtnScopeVectorscope" Tag="2" Content="3. Vectorscope" Click="BtnSelectScope_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" FontSize="10" Padding="3,5" Margin="1" Cursor="Hand"/>
                                        <Button x:Name="BtnScopeHistogram" Tag="3" Content="4. Histogram" Click="BtnSelectScope_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" FontSize="10" Padding="3,5" Margin="1" Cursor="Hand"/>
                                        <Button x:Name="BtnScopeCie" Tag="4" Content="5. CIE 1931" Click="BtnSelectScope_Click" Background="#1E293B" Foreground="#E2E8F0" FontWeight="Bold" FontSize="10" Padding="3,5" Margin="1" Cursor="Hand"/>
                                    </UniformGrid>

                                    <!-- Real-time Scope Monitor Display (Auto-scaling with no hard-coded bounds) -->
                                    <Border Grid.Row="2" Background="#0B0F17" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,0,6">
                                        <Image x:Name="ImgBroadcastScope" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>

                                    <!-- Live Telemetry Badges -->
                                    <UniformGrid Grid.Row="3" Columns="4">
                                        <Border Background="#131926" BorderBrush="#222D42" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="MAX WHITE (IRE):" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="TxtScopeMaxIre" Text="98.2 IRE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#00E676"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#131926" BorderBrush="#222D42" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="MIN BLACK (IRE):" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="TxtScopeMinIre" Text="0.8 IRE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#00E676"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#131926" BorderBrush="#222D42" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="ESTIMATED CCT:" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="TxtScopeCct" Text="5600K Daylight" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#131926" BorderBrush="#222D42" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="DOMINANT TINT:" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="TxtScopeTint" Text="Neutral" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#F59E0B"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <!-- ROW 1: VERTICAL RESIZING SPLITTER -->
                            <GridSplitter Grid.Row="1" Height="8" Background="#1E293B" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS" ToolTip="Kéo thả lên/xuống để co giãn kích thước cửa sổ thang đo màu"/>

                            <!-- ROW 2: CCU CONTROLS & 3D LUT (SCROLLVIEWER) -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                                <StackPanel>
                                    <!-- CCU COLOR CORRECTION -->
                                    <Border Style="{StaticResource SubCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="🎨 CCU COLOR CORRECTION (LIFT, GAMMA, GAIN)" FontWeight="Bold" FontSize="12.5" Foreground="#00E676" VerticalAlignment="Center"/>
