      "id": 2,
      "title": "H.264 Bandwidth (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(webrtc_camera_bitrate_kbps{codec=\"h264\"}) or vector(0)",
          "legendFormat": "H.264 (kbps)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "kbps" } }
