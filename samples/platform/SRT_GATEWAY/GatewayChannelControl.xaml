<UserControl x:Class="SRT_GATEWAY.GatewayChannelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="620">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#2D2D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="BorderBrush" Value="#33333A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="36" Height="18" Margin="0,0,6,0">
                                <Border x:Name="Track" Background="#3A3A42" CornerRadius="9" />
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#E0E0E0" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#343442"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Outer Container -->
    <Border Background="#16161C" BorderBrush="#2D2D3A" BorderThickness="1.5" CornerRadius="6" Margin="4" Padding="0">
        <ScrollViewer x:Name="ChannelScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,6,8">
            <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Channel Title & Quick Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Video Viewport (Cửa sổ xem luồng SRT Ingest) -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Tabs (Ingest / Egress Fan-out / Telemetry) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════
                 ROW 0: CHANNEL HEADER BAR
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#1E1E28" BorderBrush="#353548" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Channel ID Badge & Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BdChannelBadge" Background="#007ACC" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtChannelBadge" Text="CH 1" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBox x:Name="TxtChannelTitle" Text="CH 1: SRT GATEWAY" FontWeight="Bold" FontSize="12" Foreground="#00D2FF" Background="Transparent" BorderThickness="0" Width="170" VerticalAlignment="Center" TextChanged="Input_Changed"/>
                    </StackPanel>

                    <!-- Center: Signal Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="LedChannelStatus" Width="8" Height="8" Fill="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtChannelStatus" Text="STANDBY" FontSize="10.5" FontWeight="Bold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Border x:Name="BdSmpteBadge" Background="#004D40" CornerRadius="2" Padding="4,1" Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="SMPTE 2022-7" FontSize="9" FontWeight="Bold" Foreground="#00E676"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Quick Actions (Start/Stop + Remove) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnChannelStart" Content="▶ START" Click="BtnChannelStart_Click" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="8,3" Margin="0,0,5,0" Cursor="Hand"/>
                        <Button x:Name="BtnChannelStop" Content="⏹ STOP" Click="BtnChannelStop_Click" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="8,3" Margin="0,0,6,0" IsEnabled="False" Cursor="Hand"/>
                        <Button x:Name="BtnRemoveChannel" Content="✕" Click="BtnRemoveChannel_Click" Background="#33333E" Foreground="#FF6B6B" FontWeight="Bold" FontSize="12" Padding="7,2" ToolTip="Xóa cửa sổ luồng này khỏi Multiview" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 ROW 1: CỬA SỔ XEM LUỒNG SRT INGEST STREAM (VIDEO VIEWPORT)
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#0A0A0E" BorderBrush="#007ACC" BorderThickness="1.2" CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True">
                <Grid Height="210">
                    <!-- Video Render Canvas / Image Display -->
                    <Image x:Name="ImgVideoPreview" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Fallback / Test Pattern Screen -->
                    <Grid x:Name="PnlVideoOverlay" Background="Transparent">
                        <!-- Top OSD Bar -->
                        <Border VerticalAlignment="Top" Background="#B0000000" Padding="8,4">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OsdStreamId" Text="SRT INGEST: gateway/ch1" FontFamily="Consolas, Monospace" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock x:Name="OsdPortMode" Text=" | LISTENER :9000" FontFamily="Consolas, Monospace" FontSize="10.5" Foreground="#EEEEEE"/>
                                </StackPanel>
                                <TextBlock x:Name="OsdResolution" Text="1080p59.94 | 4:2:2" FontFamily="Consolas, Monospace" FontSize="10" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Center Watermark when not running -->
                        <StackPanel x:Name="PnlStandbyWatermark" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📺" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="SRT INGEST STREAM PREVIEW" FontWeight="Bold" FontSize="12" Foreground="#888899" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nhấn ▶ START để kết nối và mở luồng" FontSize="10.5" Foreground="#555566" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Bottom Telemetry HUD Bar -->
                        <Border VerticalAlignment="Bottom" Background="#CC0C0C12" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Telemetry Gauges -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BITRATE: " FontSize="10" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtHudBitrate" Text="0.00 Mbps" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#00E676" Margin="0,0,10,0"/>

                                    <TextBlock Text="FPS: " FontSize="10" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtHudFps" Text="0.0" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#00E676" Margin="0,0,10,0"/>

                                    <TextBlock Text="RTT: " FontSize="10" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtHudRtt" Text="0 ms" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#00D2FF" Margin="0,0,10,0"/>

                                    <TextBlock Text="LOSS: " FontSize="10" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtHudLoss" Text="0.00 %" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>

                                <!-- Active Egress Count Badge -->
                                <Border Grid.Column="1" Background="#1E1C28" BorderBrush="#3F3F50" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock x:Name="TxtHudEgressCount" Text="EGRESS: 0/0 ON" FontSize="9.5" FontWeight="Bold" Foreground="#FFB74D"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Audio VU Peak Meter -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,26,4,26" Width="12" Background="#1A1A24" CornerRadius="2" Padding="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="VuMeterL" Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#00E676" Margin="0,0,1,0"/>
                                <ProgressBar x:Name="VuMeterR" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#00E676"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 ROW 2: TABS (INGEST STREAM & MULTI-PROTOCOL EGRESS FAN-OUT)
                 ════════════════════════════════════════════════════════════ -->
            <TabControl Grid.Row="2" Background="#181822" BorderBrush="#2D2D3C" Foreground="#E0E0E0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#AAAAAA"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="#1A1A24" BorderBrush="#2D2D3C" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#181822"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: SRT INGEST STREAM (INPUT) -->
                <TabItem Header="📥 SRT INGEST (INPUT)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,6">
                        <!-- SRT RECEIVER INGEST CARD (Identical to SRT_DECODE) -->
                        <Border x:Name="CardIngest" Style="{StaticResource CardBorderStyle}" Visibility="Visible">
                            <StackPanel>
                                <!-- Header Ingest -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#DC2626" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock x:Name="TxtBadgeIngest" Text="CH 1" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF"/>
                                        </Border>
                                        <TextBlock x:Name="TxtTitleIngest" Text="SRT Receiver Ingest #1" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <Button x:Name="BtnToggleIngest" Content="Start CH 1" Click="BtnToggleIngest_Click" Background="#007ACC" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="8,3" HorizontalAlignment="Right" Cursor="Hand"/>
                                </Grid>

                                <!-- Toggle SMPTE 2022-7 Độc Lập Cho Ingest -->
                                <Border Background="#181822" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="GROUP SOCKET (SMPTE 2022-7)" FontWeight="Bold" FontSize="10.5" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleSmpteIngest" Content="BẬT / TẮT" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" Checked="ToggleSmpteIngest_Changed" Unchecked="ToggleSmpteIngest_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- Cấu hình dùng chung (Chung cho Single & SMPTE 2022-7) -->
                                <!-- Stream Name & Mode -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Tên Luồng (Display Name)" Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox x:Name="TxtIngestName" Text="CH 1" TextChanged="Input_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="SRT Mode" Style="{StaticResource HeaderLabelStyle}"/>
                                        <ComboBox x:Name="CmbIngestMode" SelectionChanged="CmbIngestMode_SelectionChanged">
                                            <ComboBoxItem Content="Listener" IsSelected="True"/>
                                            <ComboBoxItem Content="Caller"/>
                                            <ComboBoxItem Content="Rendezvous"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Stream ID & Latency -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Stream ID" Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox x:Name="TxtIngestStreamId" Text="gateway/ch1" TextChanged="Input_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Latency (ms)" Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox x:Name="TxtIngestLatency" Text="120" TextChanged="Input_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ChkAutoLatencyIngest" Content="Auto Latency (3 x RTT)" IsChecked="False" Style="{StaticResource ToggleSwitchStyle}" Margin="0,2,0,4" Checked="Input_Changed" Unchecked="Input_Changed"/>

                                <!-- Decryption (AES) -->
                                <Border Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkDecryptIngest" Content="Enable Decryption (AES)" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,4" Checked="Input_Changed" Unchecked="Input_Changed"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtIngestPassphrase" Text="" Grid.Column="0" Margin="0,0,4,0" TextChanged="Input_Changed"/>
                                            <ComboBox x:Name="CmbKeyLenIngest" Grid.Column="1" SelectionChanged="Input_Changed">
                                                <ComboBoxItem Content="256-bit" IsSelected="True"/>
                                                <ComboBoxItem Content="192-bit"/>
                                                <ComboBoxItem Content="128-bit"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ══ KHI TOGGLE = DISABLE: CHẾ ĐỘ ĐƠN LUỒNG (SINGLE STREAM) ══ -->
                                <Border x:Name="PnlSingleIngest" Visibility="Visible">
                                    <StackPanel>
                                        <!-- Bind IP / Port -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Bind IP / Remote Host" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtIngestHost" Text="0.0.0.0" TextChanged="Input_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Port UDP" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtIngestPort" Text="9000" TextChanged="Input_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Card Mạng Nguồn (Source NIC) -->
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="Card Mạng Nguồn (Source NIC):" Style="{StaticResource HeaderLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CmbNicIngest" Grid.Column="0" SelectionChanged="Input_Changed"/>
                                                <Button x:Name="BtnScanNicIngest" Content="🔄 Quét NIC" Click="BtnScanNic_Click" Grid.Column="1" Margin="4,0,0,0" Padding="8,3" FontSize="10.5" Background="#2A2A32" Foreground="#00FFCC" Cursor="Hand" ToolTip="Làm mới danh sách card mạng IPv4 cục bộ"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ══ KHI TOGGLE = ENABLE: CHẾ ĐỘ SMPTE 2022-7 HITLESS REDUNDANCY ══ -->
                                <Border x:Name="PnlGroupIngest" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Bù Trễ Vi Sai -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Bù Trễ Vi Sai (Differential Buffer):" Style="{StaticResource HeaderLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtDiffDelayIngest" Text="50" Grid.Column="0" VerticalContentAlignment="Center" TextChanged="Input_Changed"/>
                                                <TextBlock Text="ms" Grid.Column="1" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Member Socket #1: Path A (Primary) -->
                                        <Border Background="#1A2228" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                                                        <TextBlock Text="MEMBER #1: PATH A (PRIMARY INGEST)" FontWeight="Bold" FontSize="10.5" Foreground="#00E676"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.8*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Bind IP / Remote Host:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtMemberAHost" Text="0.0.0.0" TextChanged="Input_Changed"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Port UDP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtMemberAPort" Text="9000" TextChanged="Input_Changed"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Card Mạng Nguồn (NIC):" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox x:Name="CmbMemberANic" Grid.Column="0" SelectionChanged="Input_Changed"/>
                                                        <Button x:Name="BtnScanMemberANic" Content="🔄 Quét NIC" Click="BtnScanNic_Click" Grid.Column="1" Margin="4,0,0,0" Padding="8,3" FontSize="10.5" Background="#2A2A32" Foreground="#00FFCC" Cursor="Hand"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Member Socket #2: Path B (Secondary Redundant) -->
                                        <Border Background="#221E28" BorderBrush="#9C27B0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#AB47BC" Margin="0,0,6,0"/>
                                                        <TextBlock Text="MEMBER #2: PATH B (SECONDARY REDUNDANCY)" FontWeight="Bold" FontSize="10.5" Foreground="#BA68C8"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.8*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Bind IP / Remote Host:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtMemberBHost" Text="0.0.0.0" TextChanged="Input_Changed"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Port UDP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtMemberBPort" Text="9002" TextChanged="Input_Changed"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Card Mạng Phụ (NIC):" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox x:Name="CmbMemberBNic" Grid.Column="0" SelectionChanged="Input_Changed"/>
                                                        <Button x:Name="BtnScanMemberBNic" Content="🔄 Quét NIC" Click="BtnScanNic_Click" Grid.Column="1" Margin="4,0,0,0" Padding="8,3" FontSize="10.5" Background="#2A2A32" Foreground="#00FFCC" Cursor="Hand"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dynamic Member Socket Hot-Plugging Tool -->
                                        <Border Background="#1C2129" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="⚡ GẮN MEMBER SOCKET MỚI (ZERO-DISRUPTION):" FontWeight="Bold" FontSize="10.5" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Tên Member:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtNewMemberName" Text="Path C (5G)"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                        <TextBlock Text="Host / IP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtNewMemberHost" Text="0.0.0.0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                        <TextBlock Text="Port UDP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <TextBox x:Name="TxtNewMemberPort" Text="9020"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="CmbNewMemberNic" Grid.Column="0"/>
                                                    <Button x:Name="BtnScanNewMemberNic" Content="🔄 Quét NIC" Click="BtnScanNic_Click" Grid.Column="1" Margin="4,0,0,0" Padding="8,3" FontSize="10.5" Background="#2A2A32" Foreground="#00FFCC" Cursor="Hand"/>
                                                </Grid>
                                                <Button x:Name="BtnAddGroupMember" Content="＋ Gắn Member Socket Này Vào Luồng Đang Chạy" Click="BtnAddGroupMember_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" Padding="8,5" Cursor="Hand" ToolTip="Tự động kết nối member socket mới vào phiên SRT Ingest đang hoạt động mà không làm gián đoạn việc hiển thị và giải mã video"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Container danh sách Dynamic Members đã gắn -->
                                        <StackPanel x:Name="StackDynamicMembers" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: MULTI-PROTOCOL EGRESS (FAN-OUT) -->
                <!-- TAB 2: MULTI-PROTOCOL EGRESS (FAN-OUT) -->
                <TabItem Header="📤 EGRESS FAN-OUT">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Toolbar Thêm Luồng Out -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Danh sách các luồng Out động -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar Bar: Thêm Luồng Out -->
                        <Border Grid.Row="0" Background="#1C1F28" BorderBrush="#007ACC" BorderThickness="1.2" CornerRadius="5" Padding="10,6" Margin="2,0,2,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title & Counter -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DANH SÁCH LUỒNG OUT:" FontWeight="Bold" FontSize="11.5" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtActiveEgressCount" Text="0/0 BẬT" FontWeight="SemiBold" FontSize="11" Foreground="#00E676" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Middle spacer -->
                                <Grid Grid.Column="1"/>

                                <!-- Protocol Selector -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Giao thức:" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbNewEgressProtocol" Width="110" Height="28">
                                        <ComboBoxItem Content="SRT" IsSelected="True"/>
                                        <ComboBoxItem Content="WebRTC"/>
                                        <ComboBoxItem Content="RTMP"/>
                                        <ComboBoxItem Content="RTSP"/>
                                        <ComboBoxItem Content="LRT"/>
                                        <ComboBoxItem Content="HLS"/>
                                        <ComboBoxItem Content="DASH"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Add Stream Button -->
                                <Button Grid.Column="3" x:Name="BtnAddEgressStream" Content="➕ Thêm Luồng Out" Click="BtnAddEgressStream_Click" Background="#2E7D32" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,5" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Dynamic Streams Container -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,2">
                            <StackPanel x:Name="StackEgressList"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TAB 3: LOGS & TELEMETRY -->
                <TabItem Header="📊 EVENT LOG">
                    <Grid Margin="0" Background="#0C0C10">
                        <TextBox x:Name="TxtLogConsole" 
                                 IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto" 
                                 Background="#0C0C10" 
                                 Foreground="#81C784" 
                                 FontFamily="Consolas, Monospace" 
                                 FontSize="10.5" 
                                 TextWrapping="Wrap" 
                                 BorderThickness="0" 
                                 Margin="0" 
                                 Padding="8,6" 
                                 MinHeight="260" 
                                 HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</Border>
</UserControl>
