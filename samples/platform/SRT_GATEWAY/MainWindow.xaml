<Window x:Class="SRT_GATEWAY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        xmlns:local="clr-namespace:SRT_GATEWAY"
        mc:Ignorable="d"
        Title="OpenMedia SRT Gateway &amp; Telemetry Monitor"
        Height="840" Width="1440"
        MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Dark Theme Card Styles -->
        <Style x:Key="DarkCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1B1B20"/>
            <Setter Property="BorderBrush" Value="#2A2A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="20" Margin="0,0,8,0">
                                <Border x:Name="Track" Background="#3A3A42" CornerRadius="10" />
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#E0E0E0" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25252D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32323D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202028"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202028"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Master Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Main Viewport (Tab Routing / Tab Monitor) -->
            <RowDefinition Height="*"/>
            <!-- 2: Status Bar Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             0. HEADER MASTER BAR
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#16161A" BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Title & Master Toggle -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Navigation Switcher Tabs -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Quick Clocks & Status -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#007ACC" CornerRadius="4" Padding="6,4" Margin="0,0,10,0">
                        <TextBlock Text="OME" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="OPENMEDIA SRT GATEWAY &amp; TELEMETRY MONITOR" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                        <TextBlock Text="Universal Multi-Protocol Media Gateway &amp; NOC Stream Health Server" FontSize="10.5" Foreground="#888899"/>
                    </StackPanel>

                    <!-- Master Engine Start/Stop -->
                    <Button x:Name="BtnMasterStart" Content="🚀 START ALL ENGINES" Click="BtnMasterStart_Click" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="14,6" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button x:Name="BtnMasterStop" Content="⏹ STOP" Click="BtnMasterStop_Click" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="14,6" IsEnabled="False" Cursor="Hand"/>
                </StackPanel>

                <!-- Center Tabs Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1C1C24" BorderBrush="#333344" BorderThickness="1" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabBtnRouting" Content="🌐 Multiview Media Gateway Routing" IsChecked="True" Checked="TabBtn_Checked" GroupName="MainViews" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="14,6" Cursor="Hand"/>
                            <RadioButton x:Name="TabBtnMonitor" Content="📡 NOC Telemetry Monitor" Checked="TabBtn_Checked" GroupName="MainViews" Foreground="#CCCCCC" FontWeight="Bold" FontSize="12" Padding="14,6" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Clock -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E1E28" BorderBrush="#38384A" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedIngestSignal" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderIngestStatus" Text="INGEST: STANDBY" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#16181E" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="TxtMasterClock" Text="00:00:00 UTC" FontFamily="Consolas, Monospace" FontSize="13" FontWeight="Bold" Foreground="#00E676"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             1. MAIN VIEWPORT
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            
            <!-- ════════════════════════════════════════════════════════════
                 VIEW 1: MULTIVIEW MEDIA GATEWAY ROUTING
                 ════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PnlMediaGatewayView" Visibility="Visible" Margin="8,6,8,8">
                <Grid.RowDefinitions>
                    <!-- Multiview Master Toolbar (Add, Remove, Layout, Counter) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Multiview Scrollable Grid Body -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ─── Multiview Master Toolbar ────────────────────────────── -->
                <Border Grid.Row="0" Background="#181822" BorderBrush="#2F2F40" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left: Title, Counter, and + / - Buttons -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Center: Layout selectors -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Master Ingest/Egress Start All/Stop All -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title, Counter, and + / - Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📺" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MULTIVIEW ROUTING GATEWAY" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Border Background="#1C2438" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMultiviewChannelCount" Text="LUỒNG HOẠT ĐỘNG: 1" FontWeight="Bold" FontSize="11" Foreground="#00D2FF"/>
                            </Border>

                            <!-- Button (+) Thêm Luồng -->
                            <Button x:Name="BtnAddChannel" Click="BtnAddChannel_Click" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="12,5" Margin="0,0,6,0" Cursor="Hand" ToolTip="Thêm một cửa sổ xem luồng Ingest và Fan-out Egress mới">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="THÊM CỬA SỔ LUỒNG (+)" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Button (-) Bớt Luồng -->
                            <Button x:Name="BtnRemoveChannel" Click="BtnRemoveChannel_Click" Background="#33333E" Foreground="#FF6B6B" FontWeight="Bold" FontSize="11.5" Padding="10,5" Cursor="Hand" ToolTip="Bớt cửa sổ luồng cuối cùng khỏi Multiview">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➖" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="BỚT CỬA SỔ (-)" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Center: Multiview Layout Presets -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#12121A" BorderBrush="#2E2E3E" BorderThickness="1" CornerRadius="4" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LAYOUT:" FontSize="10.5" FontWeight="Bold" Foreground="#888899" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                    <RadioButton x:Name="RbLayoutAuto" Content="🔲 Auto Grid" IsChecked="True" Checked="RbLayout_Checked" GroupName="MvLayout" Foreground="#00D2FF" FontWeight="Bold" FontSize="11" Padding="8,3" Margin="0,0,4,0" Cursor="Hand"/>
                                    <RadioButton x:Name="RbLayout1x1" Content="1x1 Single" Checked="RbLayout_Checked" GroupName="MvLayout" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="11" Padding="8,3" Margin="0,0,4,0" Cursor="Hand"/>
                                    <RadioButton x:Name="RbLayout1x2" Content="1x2 Dual" Checked="RbLayout_Checked" GroupName="MvLayout" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="11" Padding="8,3" Margin="0,0,4,0" Cursor="Hand"/>
                                    <RadioButton x:Name="RbLayout2x2" Content="2x2 Quad" Checked="RbLayout_Checked" GroupName="MvLayout" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="11" Padding="8,3" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Master Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnStartAllChannels" Content="▶ CHẠY TẤT CẢ" Click="BtnStartAllChannels_Click" Background="#007ACC" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"/>
                            <Button x:Name="BtnStopAllChannels" Content="⏹ DỪNG TẤT CẢ" Click="BtnStopAllChannels_Click" Background="#4A1E1E" Foreground="#FF8A80" FontWeight="Bold" FontSize="11" Padding="10,5" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── Multiview Dynamic Grid Container ──────────────────────── -->
                <ScrollViewer Grid.Row="1" x:Name="ScrollerMultiview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="MultiviewGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <!-- Dynamic cells injected in code-behind via ApplyMultiviewLayout() -->
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 VIEW 2: NOC TELEMETRY MONITOR (GRID CARDS & AUDIT LOGS)
                 ════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PnlNocMonitorView" Visibility="Collapsed" Margin="10">
                <Grid.RowDefinitions>
                    <!-- Server Control Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Multi-Stream Wall (Grid Cards) -->
                    <RowDefinition Height="*"/>
                    <!-- Event Log & Audit Console -->
                    <RowDefinition Height="200" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Server Control Bar -->
                <Border Grid.Row="0" Style="{StaticResource DarkCardBorderStyle}" BorderBrush="#00E676" BorderThickness="1.2" Margin="0,0,0,8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toggle Server -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <CheckBox x:Name="ChkEnableMonitorServer" Content="Kích hoạt SRT Monitor Server" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" FontWeight="Bold" FontSize="12.5" Foreground="#00E676" Checked="ChkEnableMonitorServer_Changed" Unchecked="ChkEnableMonitorServer_Changed"/>
                        </StackPanel>

                        <!-- Port and LAN URL -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Port:" Style="{StaticResource HeaderLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtMonitorPort" Text="8088" Width="60" Margin="0,0,12,0" TextChanged="TxtMonitorPort_TextChanged"/>

                            <TextBlock Text="Client Telemetry URL:" Style="{StaticResource HeaderLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtMonitorClientUrl" Text="http://127.0.0.1:8088/api/telemetry" Width="260" IsReadOnly="True" Foreground="#00FFCC" Margin="0,0,6,0"/>
                            <Button Content="📋 Copy URL" Click="BtnCopyMonitorUrl_Click" Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>

                        <!-- Beeper Alert Toggle -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkBeeperAlert" Content="🔊 Cảnh báo âm thanh (Loss > 2% | RTT > 150ms)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" FontWeight="SemiBold" Foreground="#F59E0B" Checked="ChkBeeperAlert_Changed" Unchecked="ChkBeeperAlert_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MULTI-STREAM MONITORING WALL (GRID CARDS) -->
                <Border Grid.Row="1" Style="{StaticResource DarkCardBorderStyle}" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,4,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖥️ MULTI-STREAM BROADCAST MONITORING WALL" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtActiveNodeCount" Text="(0 Active Nodes)" FontSize="11" Foreground="#00E676" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Tự động phát hiện &amp; giám sát trạm phát SRT_ENCODE và trạm thu SRT_DECODE thời gian thực" FontSize="11" Foreground="#888899" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="WrapNodeCards" ItemWidth="410" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- AUDIT & EVENT LOG -->
                <Border Grid.Row="2" Style="{StaticResource DarkCardBorderStyle}" Margin="0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,4,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ NOC AUDIT LOG &amp; ALARM HISTORY" FontWeight="Bold" FontSize="11.5" Foreground="#F59E0B"/>
                                <TextBlock x:Name="TxtLogCount" Text="(0 records)" FontSize="10.5" Foreground="#888888" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="💾 Export CSV" Click="BtnExportCsv_Click" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Padding="12,3"/>
                        </Grid>

                            <DataGrid x:Name="GridAuditLogs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="#141418" Foreground="#E0E0E0" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#22222E" RowBackground="#16161C" AlternatingRowBackground="#1A1A22">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời Gian (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="110"/>
                                    <DataGridTextColumn Header="Trạm (Node)" Binding="{Binding NodeName}" Width="130"/>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding NodeType}" Width="90"/>
                                    <DataGridTextColumn Header="Sự Kiện" Binding="{Binding EventType}" Width="120"/>
                                    <DataGridTextColumn Header="Chi Tiết / Cảnh Báo" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
            </Grid>

        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
             2. STATUS BAR FOOTER
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#16161A" BorderBrush="#252530" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SRT GATEWAY &amp; TELEMETRY ENGINE" FontSize="11" FontWeight="SemiBold" Foreground="#888899"/>
                    <TextBlock Text=" | " FontSize="11" Foreground="#444455"/>
                    <TextBlock x:Name="TxtFooterIngestSummary" Text="INGEST: Stopped" FontSize="11" Foreground="#AAAAAA"/>
                    <TextBlock Text=" | " FontSize="11" Foreground="#444455"/>
                    <TextBlock x:Name="TxtFooterEgressSummary" Text="EGRESS: 0 active streams" FontSize="11" Foreground="#AAAAAA"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SMPTE 2022-7 HITLESS MERGING:" FontSize="10.5" Foreground="#888888" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtFooterSmpteStatus" Text="OFF" FontSize="10.5" FontWeight="Bold" Foreground="#888888"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
