                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#1F1F24" Padding="6,3">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="TallyCam10" Background="#333338" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="OFF" FontWeight="Bold" FontSize="9.5" Foreground="#888888"/>
                                                    </Border>
                                                    <TextBlock x:Name="TxtHeaderCam10" Text="CAM 10 (WebRTC RTP)" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="LedCam10" Width="7" Height="7" Fill="#888888" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtResFpsCam10" Text="1080p59.94" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <CheckBox x:Name="ChkVuCam10" Content="VU" IsChecked="True" Click="ChkVuCam_Click" Tag="9" Foreground="#38BDF8" FontSize="9.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Bật/tắt hiển thị Audio VU Meter"/>
                                                    <CheckBox x:Name="ChkMuteCam10" Content="MUTE" IsChecked="True" Click="ChkMuteCam_Click" Tag="9" Foreground="#EF4444" FontSize="9.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Mute âm thanh luồng này"/>
                                                    <Button x:Name="BtnSoloCam10" Content="SOLO" Click="BtnSoloCam_Click" Tag="10" FontSize="9" Padding="4,1" Background="#2C2C33" Foreground="#FFFFFF" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Background="#0A0A0C" MinHeight="130">
                                            <om:OpenMediaVideoView x:Name="VideoViewCam10" Stretch="Uniform"/>
                                            <Border x:Name="FallbackCam10" Background="#111116" Visibility="Visible">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtFallbackTitleCam10" Text="CAM 10 • WebRTC RTP" FontWeight="Bold" FontSize="12" Foreground="#555566" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtStatusCam10" Text="Standby (UDP :10036)" FontSize="10" Foreground="#444455" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="HudOverlayCam10" Background="#CC111114" CornerRadius="3" Padding="5,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="HudRttCam10" Text="RTT: 0 ms" FontSize="9.5" FontFamily="Consolas" Foreground="#00FFCC"/>
                                                    <TextBlock x:Name="HudLossCam10" Text="Loss: 0.0%" FontSize="9.5" FontFamily="Consolas" Foreground="#22C55E"/>
                                                    <TextBlock x:Name="HudBitrateCam10" Text="Bitrate: 0 kbps" FontSize="9.5" FontFamily="Consolas" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="HudDriftCam10" Text="Drift: ±0.0 ms" FontSize="9.5" FontFamily="Consolas" Foreground="#F59E0B"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Top-Right Audio VU Meter Overlay (Revealed when UNMUTED) -->
                                            <Border x:Name="OverlayAudioVuCam10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Background="#EA0C0C10" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="5,3" Visibility="Visible">
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="VU" FontSize="8" FontWeight="Bold" Foreground="#007ACC"/>
                                                        <TextBlock x:Name="TxtAudioPeakCam10" Text="-∞" FontSize="8" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#4EC9B0" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <StackPanel Width="10" Margin="0,0,2,0">
                                                            <Ellipse x:Name="ClipLedCam10_L" Width="5" Height="5" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                                            <ProgressBar x:Name="VuCam10L" Orientation="Vertical" Height="46" Width="6" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                                            <TextBlock Text="L" FontSize="7.5" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Width="10">
                                                            <Ellipse x:Name="ClipLedCam10_R" Width="5" Height="5" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                                            <ProgressBar x:Name="VuCam10R" Orientation="Vertical" Height="46" Width="6" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                                            <TextBlock Text="R" FontSize="7.5" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ══ SPLITTER CO KÉO CHIỀU DỌC CHO KHUNG LAYOUT PREVIEW ══════ -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" Cursor="SizeNS" ToolTip="Kéo chuột để điều chỉnh độ cao khung Multiviewer / Preview">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Border Background="#25252E" Height="3" CornerRadius="1.5" Margin="0,1" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- ══ BẢNG ĐIỀU KHIỂN DƯỚI: VISION SWITCHER & CONSOLE LOG ══════ -->
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Vision Switcher & Audio Bar -->
                        <RowDefinition Height="*"/>    <!-- Console Log Table -->
                    </Grid.RowDefinitions>

                    <!-- ══ VISION SWITCHER & AUDIO MONITOR BAR ════════════ -->
                    <Border Grid.Row="0" Background="#1A1A1E" BorderBrush="#2D2D33" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Program Select Bus Buttons (CAM 1..10) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PROGRAM BUS:" ToolTip="Chuột trái: Chọn PGM (On-Air - Đỏ) | Chuột phải: Chọn PVW (Standby - Xanh lá)" FontWeight="Bold" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Help"/>
                                
                                <!-- Panel for dynamic PGM buttons -->
                                <StackPanel x:Name="PanelPgmButtons" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPgmCam1" Content="CAM 1" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="0" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Visible" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam2" Content="CAM 2" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="1" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam3" Content="CAM 3" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="2" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam4" Content="CAM 4" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="3" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam5" Content="CAM 5" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="4" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam6" Content="CAM 6" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="5" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam7" Content="CAM 7" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="6" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam8" Content="CAM 8" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="7" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam9" Content="CAM 9" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="8" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                    <Button x:Name="BtnPgmCam10" Content="CAM 10" Click="BtnPgmSelect_Click" PreviewMouseRightButtonUp="BtnPgmSelect_PreviewMouseRightButtonUp" Tag="9" Background="#28282E" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="0,0,4,0" Cursor="Hand" Visibility="Collapsed" ToolTip="Chuột trái: Chọn PGM (On-Air) | Chuột phải: Chọn PVW (Standby)"/>
                                </StackPanel>

                                <!-- Transition Controls -->
                                <Button x:Name="BtnCutTransition" Content="CUT" Click="BtnCutTransition_Click" Background="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" Margin="4,0,4,0" Cursor="Hand" ToolTip="Chuyển cảnh ngay lập tức giữa PGM (Đỏ) và PVW (Xanh lá)"/>
                                <Button x:Name="BtnDissolveTransition" Content="DISSOLVE (1.0s)" Click="BtnDissolveTransition_Click" Background="#25252A" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" Padding="8,5" Cursor="Hand" ToolTip="Hòa trộn 1 giây giữa PGM (Đỏ) và PVW (Xanh lá)"/>
                            </StackPanel>

                            <!-- Audio Monitoring & Master Multi-Channel VU Meter -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Channel Configuration Selector (Stereo / 4CH / 5.1 / 7.1 / 16CH) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="CH:" FontSize="10.5" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbAudioChannels" Width="130" Height="26" SelectionChanged="CmbAudioChannels_SelectionChanged" ToolTip="Cấu hình kênh âm thanh giám sát (Stereo, 5.1, 7.1, 16CH SDI)">
                                        <ComboBoxItem Content="Stereo (2CH)" IsSelected="True"/>
                                        <ComboBoxItem Content="4-Channel (4CH)"/>
                                        <ComboBoxItem Content="5.1 Surround (6CH)"/>
                                        <ComboBoxItem Content="7.1 Surround (8CH)"/>
                                        <ComboBoxItem Content="16-Ch SDI Embedded"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Solo Audio Label -->
                                <Border Background="#141418" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎧 SOLO:" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtCurrentSolo" Text="PGM MASTER" FontWeight="Bold" FontSize="10.5" Foreground="#00FFCC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Master Multi-Channel VU Bars (16 Channels) -->
                                <Border Background="#111114" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <ProgressBar x:Name="VuMasterL" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0"/>
                                            <ProgressBar x:Name="VuMasterR" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0"/>
                                            <ProgressBar x:Name="VuMaster3" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster4" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster5" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster6" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster7" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster8" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster9" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster10" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster11" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster12" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster13" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster14" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster15" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Margin="0,0,1,0" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="VuMaster16" Width="3" Height="24" Style="{StaticResource VuMeterBarStyle}" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtMasterPeakDb" Text="-18.0 dB" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="#22C55E" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Button Mute Preview Audio (Muted by default) -->
                                <Button x:Name="BtnMutePreview" Content="🔇 PREVIEW MUTED" Click="BtnMutePreview_Click" Background="#EF4444" BorderBrush="#DC2626" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="8,5" Cursor="Hand" ToolTip="Đang MUTE loa kiểm âm tại chỗ (âm thanh trong luồng Stream/NDI vẫn phát 100%)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ BOTTOM LOG CONSOLE & SYSTEM STATUS ═════════════ -->
                    <Border Grid.Row="1" Background="#18181C" BorderBrush="#28282E" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Log Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋 BROADCAST EVENT &amp; SYNC LOG" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="ChkAutoScroll" Content="Auto Scroll" IsChecked="True" Foreground="#888888" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Clear Logs" Click="BtnClearLogs_Click" Background="#26262B" Foreground="#AAAAAA" FontSize="10" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"/>
                                    <Button Content="Copy" Click="BtnCopyLogs_Click" Background="#26262B" Foreground="#AAAAAA" FontSize="10" Padding="6,2" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <!-- Console Log Text View -->
                            <ScrollViewer x:Name="ScrollerLogs" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#101012">
                                <TextBox x:Name="TxtLogConsole" Background="Transparent" Foreground="#D0D0D0" FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Padding="4"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ────────────────────────────────────────────────────────────── -->
            <!-- SPLITTER                                                       -->
            <!-- ────────────────────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- ────────────────────────────────────────────────────────────── -->
            <!-- RIGHT COLUMN: CONFIGURATION & CONTROL TABS                     -->
            <!-- ────────────────────────────────────────────────────────────── -->
            <Border Grid.Column="2" Background="#18181B" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="6" Padding="6">
                <TabControl x:Name="TabsMainConfig">

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 1: 1. WEBRTC INGEST (DYNAMIC STREAMS UP TO 10)     -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="1. WebRTC Ingest">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel x:Name="StackIngestContainer">
                                <!-- Ingest Management Toolbar Card with '+' Button on second row -->
                                <Border Style="{StaticResource CardBorderStyle}" Background="#1C1C22" BorderBrush="#007ACC">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="WEBRTC / SFU CAMERA INGEST" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF"/>
                                                <Border Background="#007ACC" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock x:Name="TxtStreamCountBadge" Text="Active: 1/10" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Buttons moved to bottom row with Port Mode Quick Switchers -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnAddStream" Content="＋ Thêm Luồng Ingest Mới" Click="BtnAddStream_Click" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" ToolTip="Thêm một luồng WebRTC Camera Stream mới (tối đa 10 luồng)"/>
                                            <Button x:Name="BtnRemoveStream" Content="－ Bớt Luồng" Click="BtnRemoveStream_Click" Background="#2E2E36" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="11" Padding="8,6" Grid.Column="1" Cursor="Hand" ToolTip="Xóa bớt luồng cuối cùng"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnAllDualPort" Content="⚡ Đặt Tất cả 2 Ports (Split)" Click="BtnAllDualPort_Click" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Foreground="#93C5FD" FontSize="10.5" FontWeight="SemiBold" Padding="6,3" Margin="0,0,4,0" Cursor="Hand" ToolTip="Chuyển toàn bộ 10 camera sang chế độ 2 Port (10000 Video &amp; 10002 Audio)"/>
                                            <Button x:Name="BtnAllSinglePort" Content="🌐 Đặt Tất cả 1 Port (BUNDLE)" Click="BtnAllSinglePort_Click" Background="#1E293B" BorderBrush="#10B981" BorderThickness="1" Foreground="#6EE7B7" FontSize="10.5" FontWeight="SemiBold" Padding="6,3" Margin="4,0,0,0" Grid.Column="1" Cursor="Hand" ToolTip="Chuyển toàn bộ 10 camera sang chế độ 1 Port gộp (Muxed BUNDLE)"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SIGNALING SERVER CONNECTION CARD -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="SIGNALING SERVER (WEBSOCKET)" FontWeight="Bold" FontSize="12" Foreground="#007ACC" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Signaling Server URL:" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtSignalingUrl" Text="ws://127.0.0.1:3000/ws"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                                <Button x:Name="BtnToggleSignaling" Content="🔗 Connect Signaling" Background="#007ACC" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,5" Height="28" Cursor="Hand" Click="BtnToggleSignaling_Click"/>
                                            </StackPanel>
