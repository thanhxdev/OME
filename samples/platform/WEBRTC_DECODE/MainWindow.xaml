                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Header="6. Audio Mixer">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel Margin="2">
                                                                <!-- Top Toolbar Card: Audio Mixer & Director Mic Setup (2 Dòng gọn gàng) -->
                                <Border Style="{StaticResource CardBorderStyle}" Background="#16171D" BorderBrush="#25252C" Margin="0,0,0,6" Padding="8,5">
                                    <StackPanel>
                                        <!-- DÒNG 1: Tiêu đề Console & Tính năng Mix-Minus -->
                                        <Grid Margin="0,0,0,5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔊 STUDIO AUDIO MIXER" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                <Border Background="#007ACC" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="2x6 CONSOLE" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF"/>
                                                </Border>
                                                <Border x:Name="PnlMixMinusBadge" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtMixMinusBadge" Text="MIX-MINUS (N-1)" FontWeight="Bold" FontSize="8.5" Foreground="#34D399"/>
                                                </Border>
                                                <CheckBox x:Name="ChkEnableMixMinus" Content="2.0 Mix-Minus" IsChecked="True" Checked="ChkEnableMixMinus_Changed" Unchecked="ChkEnableMixMinus_Changed" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" ToolTip="Tự động loại trừ tiếng camera đó khi phát IFB Return về, triệt tiêu tiếng vọng trễ mạng." VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- DÒNG 2: Cấu hình Micro & Loa Phát Đạo Diễn (Auto Scan Speaker/Headphone) -->
                                        <Border Background="#101116" BorderBrush="#23232A" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                            <StackPanel>
                                                <!-- 1. Thu: Micro Đạo Diễn -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="ChkEnableStudioMic" Content="🎙️ Mic Director" IsChecked="False" Checked="ChkEnableStudioMic_Changed" Unchecked="ChkEnableStudioMic_Changed" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" ToolTip="Thu âm giọng đạo diễn studio đưa vào đường IFB / Mix-Minus gửi về hiện trường. Mặc định TẮT."/>
                                                    <Border x:Name="PnlStudioMicBadge" Background="#262626" BorderBrush="#525252" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtStudioMicBadge" Text="DISABLED" FontSize="8.5" FontWeight="Bold" Foreground="#9E9E9E"/>
                                                    </Border>
                                                    <ComboBox x:Name="CmbStudioMicDevice" Width="180" Height="22" FontSize="9.5" IsEnabled="False" SelectionChanged="CmbStudioMicDevice_SelectionChanged" DropDownOpened="CmbStudioMicDevice_DropDownOpened" VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="Chọn ngõ vào Micro cho đạo diễn (Nhấn nút Refresh để quét)"/>
