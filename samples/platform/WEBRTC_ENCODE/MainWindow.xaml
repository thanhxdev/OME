<Window x:Class="WEBRTC_ENCODE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        xmlns:local="clr-namespace:WEBRTC_ENCODE"
        mc:Ignorable="d"
        Title="ENCODER"
        Height="760" Width="1220"
        MinHeight="550" MinWidth="900"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Foreground="#E0E0E0"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewKeyUp="MainWindow_PreviewKeyUp">

    <Window.Resources>
        <!-- Custom Styles -->
        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="DarkCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="BorderBrush" Value="#2A2A30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardBorderStyle" BasedOn="{StaticResource DarkCardBorderStyle}" TargetType="Border"/>

        <!-- Toggle Switch CheckBox Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="44" Height="22" Margin="0,0,10,0">
                                <Border x:Name="Track" Background="#3A3A3C" CornerRadius="11" />
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#E0E0E0" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Radio Button Style for Pipeline Mode Switch -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333338"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Dark Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="4"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="#CCCCCC" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#007ACC" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1A1A1E"
                                            BorderThickness="1"
                                            BorderBrush="#007ACC"
                                            CornerRadius="4"
                                            Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333338"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header Status Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Main Content Split View -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Action / Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             TOP HEADER & MASTER STATUS BAR
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#18181C" BorderBrush="#2A2A30" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand / Title -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Quick Status Badges -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Clocks -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#007ACC" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="WEBRTC" FontWeight="Black" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="ENCODER" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Engine State Indicator -->
                    <Border Background="#252526" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedEngineStatus" Width="9" Height="9" Fill="#F44336" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtEngineStatus" Text="Engine: Ready" FontSize="12" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- Signaling State Indicator -->
                    <Border Background="#252526" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedSignalingStatus" Width="9" Height="9" Fill="#FFC107" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtSignalingStatus" Text="Signaling: Disconnected" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- Tally Status Indicator -->
                    <Border x:Name="BadgeTallyFeedback" Background="#222228" BorderBrush="#44444A" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedTallyStatus" Width="9" Height="9" Fill="#555555" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTallyStatus" Text="TALLY: OFF-AIR" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                        </StackPanel>
                    </Border>

                    <!-- Intercom Indicator (Always visible, color indicates ON/OFF) -->
                    <Border x:Name="BadgeIntercom" Background="#222228" BorderBrush="#44444A" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,8,0" Visibility="Visible">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedIntercomStatus" Width="9" Height="9" Fill="#555555" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtIntercomInfo" Text="INTERCOM: DIRECTOR (OFF)" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                        </StackPanel>
                    </Border>

                    <!-- NTP Wall-Clock Sync Badge -->
                    <Border x:Name="BadgeNtpSync" Background="#372D1E" BorderBrush="#F57C00" BorderThickness="1" CornerRadius="12" Padding="8,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" Margin="0,0,4,0"/>
                            <TextBlock Text="NTP SYNC" FontSize="11" FontWeight="Bold" Foreground="#FFB74D"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Master UTC Clock -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MASTER UTC:" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="#0A0A0A" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtMasterUtcTime" Text="00:00:00.000" FontFamily="Consolas, Monospace" FontSize="14" FontWeight="Bold" Foreground="#00E676"/>
                    </Border>
                    <Border Background="#141E18" BorderBrush="#00E676" BorderThickness="1" CornerRadius="4" Padding="6,3">
                        <TextBlock x:Name="TxtMasterSmpteTime" Text="00:00:00:00" FontFamily="Consolas, Monospace" FontSize="13" FontWeight="Bold" Foreground="#00FFCC"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             MAIN CONTENT AREA (2-COLUMN GRID)
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Left: Video Preview & VU Meters & Log (Approx 58%) -->
                <ColumnDefinition Width="6.2*" MinWidth="400"/>
                <ColumnDefinition Width="6"/>
                <!-- Right: Configuration Tabs (Approx 42%) -->
                <ColumnDefinition Width="4.8*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PREVIEW SCREEN, AUDIO VU METERS, LOG CONSOLE -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3.8*" MinHeight="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- 1. Video Display Area with Tally Border Glow -->
                <Border x:Name="BrdVideoContainer" Grid.Row="0" Background="#000000" BorderBrush="#2D2D30" BorderThickness="2" CornerRadius="6" Margin="0,0,0,6" ClipToBounds="True">
                    <Grid x:Name="PnlMasterProgramBus" ClipToBounds="True">
                        <!-- DirectX 11 Hardware Render View -->
                        <om:OpenMediaVideoView x:Name="ReviewView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- SMPTE RP 219 Colorbar Pattern View -->
                        <Viewbox x:Name="ViewboxColorbar" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                            <Grid x:Name="PnlColorbarPattern" Width="1920" Height="1080">
                                <Grid x:Name="PnlColorbarVisualHost" Width="1920" Height="1080"/>

                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D00A0A0E" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="12" Padding="28,16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtColorbarIdentTitle" Text="SMPTE RP 219 COLORBAR PATTERN" FontWeight="Bold" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtColorbarIdentTone" Text="AUDIO: 1 kHz Sinewave @ -18 dBFS (EBU Standard)" FontWeight="SemiBold" FontSize="15" Foreground="#4EC9B0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        
                                        <Border Background="#000000" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="18,6" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="UTC TIME: " FontSize="16" Foreground="#888888" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtColorbarUtcTime" Text="00:00:00.000" FontFamily="Consolas, Monospace" FontSize="24" FontWeight="Bold" Foreground="#00E676" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="1080p 30 fps • WebRTC Broadcast Ingress Ready" FontSize="13" Foreground="#888888" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Viewbox>

                        <!-- Preview Disabled Placeholder Screen -->
                        <Grid x:Name="PnlPreviewDisabled" Background="#111111" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📺" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                <TextBlock Text="VIDEO PREVIEW MUTED (SAVING GPU)" FontSize="13" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock Text="Encoder &amp; WebRTC Transmission are still actively running." FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Source Watermark Badge (Top Left) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Background="#90000000" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedLiveInput" Width="8" Height="8" Fill="#00E676" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtActiveSourceBadge" Text="INPUT: COLORBAR" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <!-- Tally Watermark (Top Center) -->
                        <Border x:Name="BrdOnAirBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Background="#DC2626" CornerRadius="4" Padding="12,4" Visibility="Collapsed">
                            <TextBlock Text="🔴 ON-AIR (PGM)" FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                        </Border>

                        <!-- WebRTC Telemetry HUD Overlay -->
                        <Border x:Name="OverlayTelemetry" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="#CC121216" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="Visible">
                            <StackPanel Width="236">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="REAL-TIME TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center"/>
                                    <Border x:Name="BrdHudQosBadge" HorizontalAlignment="Right" Background="#1B5E20" CornerRadius="3" Padding="6,1.5">
                                        <TextBlock x:Name="TxtHudQos" Text="● EXCELLENT (100%)" FontSize="9" FontWeight="Bold" Foreground="#69F0AE"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="⏱️ ICE / SFU RTT:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudRtt" Text="0 ms" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#00E676"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="📉 Packet Loss:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudLoss" Text="0.0 %" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#00E676"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="📶 Jitter:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudJitter" Text="0.0 ms" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#64B5F6"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="🚀 Total Bitrate:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudBitrate" Text="0 kbps" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#00E676"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <TextBlock Text="   ↳ V / A Rate:" FontSize="9.5" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtHudBitrateDetail" Text="V: 0k | A: 0k" HorizontalAlignment="Right" FontSize="9.5" Foreground="#AAAAAA"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="🎞️ FPS / Drop:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudFps" Text="0.0 FPS (Drop: 0)" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="🔄 NACK / Retrans:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudNack" Text="0 pkts" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#FFD54F"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="🔑 Keyframe PLIs:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudPli" Text="0 reqs" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="🕒 Master PTS:" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudPts" Text="00:00:00.000" FontFamily="Consolas, Monospace" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#FFD54F"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Multi-Channel Audio VU Meter Overlay (Bottom-Left) -->
                        <Border x:Name="OverlayAudioVu" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12" Background="#EA0C0C10" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Visibility="Visible">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1E3A5F" CornerRadius="3" Padding="4,1">
