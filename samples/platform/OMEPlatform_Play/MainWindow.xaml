<Window x:Class="OMEPlatform_Play.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        Title="OMEPlatform Play — OpenMedia Player Sample" 
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="#181825"
        Foreground="#CDD6F4"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ParamName">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ParamValue">
            <Setter Property="Foreground" Value="#F5E0DC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Controls & File Selection -->
            <RowDefinition Height="*"/>
            <!-- Main Content: Parameters Panel & Video Preview -->
            <RowDefinition Height="Auto"/>
            <!-- Seek & Time Jump Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Transport Controls & Audio -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Bar: Open File & Title -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="BtnOpenFile" Click="BtnOpenFile_Click" ToolTip="Chọn file video để phát (Hoặc kéo thả file vào cửa sổ)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="14"/>
                            <TextBlock Text="Chọn File Video..." FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TxtFilePath" Grid.Column="1" VerticalAlignment="Center" Margin="16,0" 
                           Foreground="#A6E3A1" FontStyle="Italic" TextTrimming="CharacterEllipsis"
                           Text="Kéo thả tập tin video hoặc bấm 'Chọn File Video...' để bắt đầu."/>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Scale Fit: " VerticalAlignment="Center" Foreground="#A6ADC8" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbStretchMode" Width="110" SelectionChanged="CmbStretchMode_SelectionChanged"
                              Background="#313244" Foreground="#CDD6F4" Padding="4,2" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Fit (Uniform)" IsSelected="True"/>
                        <ComboBoxItem Content="Fill (UniformToFill)"/>
                        <ComboBoxItem Content="Stretch"/>
                        <ComboBoxItem Content="Center (None)"/>
                    </ComboBox>

                    <CheckBox x:Name="ChkEnableVideo" Content="View Video" IsChecked="True" 
                              Checked="ChkEnableVideo_CheckedChanged" Unchecked="ChkEnableVideo_CheckedChanged"
                              Margin="12,0,0,0" ToolTip="Bật / Tắt khung hiển thị preview video"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Parameters & Preview -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Video Parameters Card -->
            <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="6" Padding="12" Margin="0,0,10,0" BorderBrush="#313244" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="📊 Thông Số Video" Style="{StaticResource HeaderLabel}" Margin="0,0,0,10"/>
                        <Rectangle Height="1" Fill="#313244" Margin="0,0,0,10"/>

                        <!-- Parameter Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên File:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtFileName" Grid.Row="0" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời lượng:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtParamDuration" Grid.Row="1" Grid.Column="1" Text="--:--:--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ phân giải:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtResolution" Grid.Row="2" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Khung hình (FPS):" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtFrameRate" Grid.Row="3" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Video Codec:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtVideoCodec" Grid.Row="4" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Audio Codec:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtAudioCodec" Grid.Row="5" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Kênh Audio:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtAudioChannels" Grid.Row="6" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Sample Rate:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtSampleRate" Grid.Row="7" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Bitrate:" Style="{StaticResource ParamName}"/>
                            <TextBlock x:Name="TxtBitrate" Grid.Row="8" Grid.Column="1" Text="--" Style="{StaticResource ParamValue}"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#313244" Margin="0,12,0,10"/>
                        <TextBlock Text="💡 Ghi chú" Style="{StaticResource HeaderLabel}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="• Tích/Bỏ tích 'View Video' để bật/tắt xem hình ảnh." Foreground="#6C7086" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="• Tích/Bỏ tích 'Audio' để bật/tắt âm thanh." Foreground="#6C7086" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="• Nhập mốc thời gian dạng 00:01:30 để tua nhanh đến thời điểm cần xem." Foreground="#6C7086" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Video Preview Container -->
            <Border Grid.Column="1" Background="#11111B" CornerRadius="6" BorderBrush="#313244" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- OpenMedia Video Control -->
                    <om:OpenMediaVideoView x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Placeholder / Hidden Overlay -->
                    <Border x:Name="PnlVideoDisabled" Background="#181825" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🚫" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Preview Video đang bị tắt (Unchecked View Video)" Foreground="#A6ADC8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Seek Bar & Time Selection Bar -->
        <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <!-- Current Position -->
                    <ColumnDefinition Width="*"/>
                    <!-- Seek Slider -->
                    <ColumnDefinition Width="70"/>
                    <!-- Total Duration -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Jump to time input -->
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtPosition" Grid.Column="0" Text="00:00:00" Foreground="#89B4FA" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Slider x:Name="SldPosition" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" 
                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        Thumb.DragStarted="SldPosition_DragStarted" 
                        Thumb.DragCompleted="SldPosition_DragCompleted" 
                        ValueChanged="SldPosition_ValueChanged"/>

                <TextBlock x:Name="TxtDuration" Grid.Column="2" Text="00:00:00" Foreground="#A6ADC8" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Jump to Time Control -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Tua đến:" VerticalAlignment="Center" Foreground="#A6ADC8" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtJumpTime" Width="75" Text="00:00:00" Background="#313244" Foreground="#CDD6F4" 
                             BorderBrush="#45475A" Padding="4,2" VerticalContentAlignment="Center" TextAlignment="Center" ToolTip="Nhập định dạng HH:mm:ss hoặc số giây"/>
                    <Button x:Name="BtnJumpTime" Content="Go ➔" Click="BtnJumpTime_Click" Margin="4,0,0,0" Padding="8,4" ToolTip="Tua phát từ thời gian đã chọn"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport Controls & Audio -->
        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Empty / Extra Action -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRewind10" Content="⏪ -10s" Click="BtnRewind10_Click" Width="65"/>
                    <Button x:Name="BtnForward10" Content="+10s ⏩" Click="BtnForward10_Click" Width="65"/>
                </StackPanel>

                <!-- Center Playback Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnPlay" Click="BtnPlay_Click" Width="90" Height="36" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶ " FontSize="14"/>
                            <TextBlock Text="Play"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPause" Click="BtnPause_Click" Width="90" Height="36" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" Margin="4,0" ToolTip="Tạm dừng phát video (Pause / Resume)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtPauseIcon" Text="⏸ " FontSize="14"/>
                            <TextBlock x:Name="TxtPauseText" Text="Pause"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStop" Click="BtnStop_Click" Width="90" Height="36" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹ " FontSize="14"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Audio Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAudio" Content="Audio" IsChecked="True" 
                              Checked="ChkAudio_CheckedChanged" Unchecked="ChkAudio_CheckedChanged" 
                              ToolTip="Check / Uncheck để Bật / Tắt âm thanh (Mute/Unmute)"/>

                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <Slider x:Name="SldVolume" Width="100" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center" 
                            ValueChanged="SldVolume_ValueChanged" ToolTip="Âm lượng"/>
                    <TextBlock x:Name="TxtVolumePercent" Text="100%" Width="40" VerticalAlignment="Center" Foreground="#A6ADC8" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#11111B" CornerRadius="4" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Đang khởi tạo OpenMedia.Platform Engine..." Foreground="#FAB387"/>
                <TextBlock x:Name="TxtEngineState" Grid.Column="1" Text="Engine: Initializing" Foreground="#6C7086"/>
            </Grid>
        </Border>
    </Grid>
</Window>
