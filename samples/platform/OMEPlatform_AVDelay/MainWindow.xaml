<Window x:Class="OMEPlatform_AVDelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        Title="OMEPlatform_AVDelay - Broadcast Monitor" Height="800" Width="1000"
        Background="#1E1E1E" Foreground="White"
        Loaded="Window_Loaded" Unloaded="Window_Unloaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 📺 Vùng 1: Video Preview Panel -->
        <Grid Grid.Row="0" Margin="10" Background="Black">
            <om:OpenMediaVideoView x:Name="VideoView" />
            
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#80000000">
                <TextBlock x:Name="StatusOverlay" Text="Status: Initializing..." Padding="5" Foreground="#00FF00" FontFamily="Consolas" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- 🎮 Vùng 2: Standard Playback Controls -->
        <Border Grid.Row="1" Background="#252525" Margin="10,0,10,10" Padding="10" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seekbar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="00:00.000" Grid.Column="0" FontFamily="Consolas" Width="80"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" 
                            IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" 
                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown" />
                    <TextBlock x:Name="DurationText" Text="00:00.000" Grid.Column="2" FontFamily="Consolas" Width="80" TextAlignment="Right"/>
                </Grid>

                <!-- Buttons & Volume -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Open File" Click="BtnOpen_Click" FontWeight="Bold"/>
                    <Button Content="Open URL" Click="BtnOpenUrl_Click" FontWeight="Bold"/>
                    <Separator Width="20" Opacity="0"/>
                    <Button Content="Play" Click="BtnPlay_Click"/>
                    <Button Content="Pause" Click="BtnPause_Click"/>
                    <Button Content="Stop" Click="BtnStop_Click"/>
                    <Separator Width="20" Opacity="0"/>
                    <Button x:Name="BtnMute" Content="🔊" Click="BtnMute_Click" Width="40" Padding="0"/>
                    <Slider x:Name="VolumeSlider" Width="100" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="1" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ⏱️ Vùng 3: Advanced Delay Control Panel -->
        <Border Grid.Row="2" Background="#151515" BorderBrush="#333" BorderThickness="1" Margin="10,0,10,10" Padding="15" CornerRadius="5">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="ADVANCED A/V DELAY CONTROL" Foreground="#00AAFF" FontWeight="Bold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="LockRatioCheck" Content="Lock A/V Ratio" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                        <Button Content="Reset All Delays" Click="BtnResetDelays_Click" Background="#442222" BorderBrush="#AA4444"/>
                    </StackPanel>
                </Grid>

                <!-- Video Delay -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🎬 Video Delay:" Grid.Column="0" FontWeight="SemiBold"/>
                    <Slider x:Name="VideoDelaySlider" Grid.Column="1" Minimum="0" Maximum="5000" Value="0" 
                            TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"
                            ValueChanged="VideoDelaySlider_ValueChanged"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBox x:Name="VideoDelayText" Text="0" Width="50" TextAlignment="Right" KeyDown="VideoDelayText_KeyDown"/>
                        <TextBlock Text=" ms" Margin="5,0,0,0"/>
                    </StackPanel>
                    <Button Content="-50ms" Grid.Column="3" Click="BtnVideoMinus_Click" Margin="5,0"/>
                    <Button Content="+50ms" Grid.Column="4" Click="BtnVideoPlus_Click" Margin="5,0"/>
                </Grid>

                <!-- Audio Delay -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔊 Audio Delay:" Grid.Column="0" FontWeight="SemiBold"/>
                    <Slider x:Name="AudioDelaySlider" Grid.Column="1" Minimum="-2000" Maximum="5000" Value="0" 
                            TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"
                            ValueChanged="AudioDelaySlider_ValueChanged"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBox x:Name="AudioDelayText" Text="0" Width="50" TextAlignment="Right" KeyDown="AudioDelayText_KeyDown"/>
                        <TextBlock Text=" ms" Margin="5,0,0,0"/>
                    </StackPanel>
                    <Button Content="-50ms" Grid.Column="3" Click="BtnAudioMinus_Click" Margin="5,0"/>
                    <Button Content="+50ms" Grid.Column="4" Click="BtnAudioPlus_Click" Margin="5,0"/>
                </Grid>

                <!-- Master Delay -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⏱️ Master Delay:" Grid.Column="0" FontWeight="SemiBold" Foreground="#FFAA00"/>
                    <Slider x:Name="MasterDelaySlider" Grid.Column="1" Minimum="0" Maximum="10000" Value="0" 
                            TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"
                            ValueChanged="MasterDelaySlider_ValueChanged"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBox x:Name="MasterDelayText" Text="0" Width="50" TextAlignment="Right" KeyDown="MasterDelayText_KeyDown"/>
                        <TextBlock Text=" ms" Margin="5,0,0,0"/>
                    </StackPanel>
                    <Button Content="-50ms" Grid.Column="3" Click="BtnMasterMinus_Click" Margin="5,0"/>
                    <Button Content="+50ms" Grid.Column="4" Click="BtnMasterPlus_Click" Margin="5,0"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
