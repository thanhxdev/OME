                                        <TextBlock Text="-6" FontSize="7.5" Foreground="#FFB74D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,0,0"/>
                                        <TextBlock Text="-12" FontSize="7.5" Foreground="#FFD54F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,0,0"/>
                                        <TextBlock Text="-18" FontSize="7.5" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,0,0"/>
                                        <TextBlock Text="-24" FontSize="7.5" Foreground="#81C784" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,0,0"/>
                                        <TextBlock Text="-40" FontSize="7.5" Foreground="#666666" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                        <TextBlock Text="-60" FontSize="7.5" Foreground="#444444" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-2"/>
                                    </Grid>

                                    <!-- 16 Channel Strips in Pairs -->
