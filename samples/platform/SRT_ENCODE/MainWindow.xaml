                                        <ProgressBar x:Name="VuBar6" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu6" Text="6" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Pair 7-8 -->
                                    <StackPanel x:Name="ColVu7" Width="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="ClipLed7" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar7" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu7" Text="7" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ColVu8" Width="13" Margin="0,0,4,0">
                                        <Ellipse x:Name="ClipLed8" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar8" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu8" Text="8" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Pair 9-10 -->
                                    <StackPanel x:Name="ColVu9" Width="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="ClipLed9" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar9" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu9" Text="9" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ColVu10" Width="13" Margin="0,0,4,0">
                                        <Ellipse x:Name="ClipLed10" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar10" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu10" Text="10" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

