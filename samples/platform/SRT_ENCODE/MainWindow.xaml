                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════
                         TAB 2: INPUT SOURCE SELECTION (DEFAULT: SDI)
                         ════════════════════════════════════════════════════ -->
