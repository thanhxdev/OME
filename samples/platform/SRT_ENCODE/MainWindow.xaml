                                    <StackPanel x:Name="ColVu11" Width="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="ClipLed11" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar11" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu11" Text="11" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ColVu12" Width="13" Margin="0,0,4,0">
                                        <Ellipse x:Name="ClipLed12" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar12" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu12" Text="12" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Pair 13-14 -->
                                    <StackPanel x:Name="ColVu13" Width="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="ClipLed13" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar13" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu13" Text="13" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ColVu14" Width="13" Margin="0,0,4,0">
                                        <Ellipse x:Name="ClipLed14" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar14" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu14" Text="14" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Pair 15-16 -->
                                    <StackPanel x:Name="ColVu15" Width="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="ClipLed15" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar15" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu15" Text="15" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ColVu16" Width="13">
                                        <Ellipse x:Name="ClipLed16" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar16" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
                                        <TextBlock x:Name="LblVu16" Text="16" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Preview & Monitoring Toggles -->
                <Border Grid.Row="1" Style="{StaticResource DarkCardBorderStyle}" Margin="0,0,0,6" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toggle Video Preview -->
                        <CheckBox x:Name="ChkEnableVideoPreview" Grid.Column="0" Content="Video Preview" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ChkEnableVideoPreview_Changed" Unchecked="ChkEnableVideoPreview_Changed" Margin="0,0,12,0"/>

                        <!-- Toggle Audio VU Meter -->
                        <CheckBox x:Name="ChkEnableAudioMonitor" Grid.Column="1" Content="Audio VU Meter" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ChkEnableAudioMonitor_Changed" Unchecked="ChkEnableAudioMonitor_Changed" Margin="0,0,12,0" ToolTip="Hiển thị hoặc ẩn đồng hồ đo Audio VU Meter trên màn hình xem trước"/>

                        <!-- Toggle Telemetry HUD -->
                        <CheckBox x:Name="ChkShowTelemetry" Grid.Column="2" Content="Telemetry HUD" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ChkShowTelemetry_Changed" Unchecked="ChkShowTelemetry_Changed" Margin="0,0,12,0"/>

                        <!-- Aspect Ratio Scaling Button (Aspect Fit / Aspect Scale) -->
                        <Button x:Name="BtnAspectMode" Grid.Column="3" Content="📐 Aspect: Fit" Background="#252526" Foreground="#00E676" BorderBrush="#007ACC" BorderThickness="1" Padding="8,2" FontSize="11" FontWeight="SemiBold" Height="24" Cursor="Hand" Click="BtnAspectMode_Click" ToolTip="Click để chuyển đổi: Aspect Fit (Giữ đúng tỉ lệ) / Aspect Scale (Lấp đầy toàn bộ khung)" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Volume & Audio Mute/Unmute Controls (Default: Muted) -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnAudioMute" Style="{StaticResource IconOnlyButtonStyle}" Click="BtnAudioMute_Click" ToolTip="Loa kiểm âm (Monitor Speaker): Đang tắt tiếng (MUTED) - Click để Mở tiếng (UNMUTE)" Margin="0,0,3,0">
                                <TextBlock x:Name="TxtAudioMuteIcon" Text="🔇" FontSize="13" Foreground="#FF5252" VerticalAlignment="Center"/>
                            </Button>
                            <TextBlock Text="Vol:" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider x:Name="SldMonitorVolume" Width="70" Minimum="0" Maximum="1" Value="0.7" ValueChanged="SldMonitorVolume_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMonitorVolumeVal" Text="70%" FontSize="11" Foreground="#FFFFFF" Width="28" TextAlignment="Right" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Activity Log Console -->
                <Border Grid.Row="2" Background="#181818" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" Padding="8,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="EVENT &amp; BROADCAST LOG (NEWEST ON TOP)" FontWeight="Bold" FontSize="10" Foreground="#9E9E9E"/>
                            </StackPanel>
                            <Button Content="Clear Logs" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Padding="6,1" FontSize="10" Height="20" Click="BtnClearLog_Click"/>
                        </Grid>

                        <ScrollViewer x:Name="ScrollerLogs" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtLogConsole" Background="Transparent" Foreground="#D4D4D4" BorderThickness="0" FontFamily="Cascadia Mono, Consolas, Courier New, Monospace" FontSize="9.5" Padding="0" Margin="0" Height="Auto" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter Line -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#2D2D30"/>

            <!-- ────────────────────────────────────────────────────────────
                 RIGHT COLUMN: CONFIGURATION TABS
                 ──────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <TabControl Background="#1E1E1E" BorderBrush="#2D2D30" Foreground="#E0E0E0">
                    <!-- Tab Style Customization -->
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#252526"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="BorderBrush" Value="#2D2D30"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                                <Setter Property="Foreground" Value="#007ACC"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ════════════════════════════════════════════════════
                         TAB 1: SRT TRANSMISSION PROTOCOL CONFIG (DEFAULT TAB 1)
                         ════════════════════════════════════════════════════ -->
                    <TabItem Header="🌐 1. SRT Config">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <!-- ════════════════════════════════════════════════════
                                     🌐 DANH SÁCH
                                     ════════════════════════════════════════════════════ -->
                                <Border Background="#1A1D24" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="DANH SÁCH" FontWeight="Bold" FontSize="13" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Target Action Buttons: [➕ Thêm Luồng] and [➖ Xoá Luồng] -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnAddTarget" Content="➕ Thêm Luồng" Background="#2E7D32" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,5" Margin="0,0,8,0" Cursor="Hand" Click="BtnAddTarget_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button x:Name="BtnRemoveTarget" Content="➖ Xoá Luồng" Background="#3E3E42" Foreground="#FF8A80" FontWeight="Bold" FontSize="11" Padding="10,5" Cursor="Hand" Click="BtnRemoveTarget_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Target Selector & Friendly Name Row -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Chọn Luồng Hiện Hành:" Style="{StaticResource HeaderLabelStyle}"/>
                                                <ComboBox x:Name="CmbTargetList" SelectionChanged="CmbTargetList_SelectionChanged" Height="30"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Tên Gợi Nhớ Luồng (Friendly Target Name):" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtTargetName" Text="Luồng #1 (Primary)" TextChanged="TxtTargetName_TextChanged" Height="30" VerticalContentAlignment="Center" Background="#252526" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ════════════════════════════════════════════════════
                                     STREAM ACTION BAR (ĐỘC LẬP TỪNG LUỒNG)
                                     ════════════════════════════════════════════════════ -->
                                <Border Background="#16181C" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Left: START / STOP buttons for this target -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Center: Status LED & Text -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Right: Mini HUD Telemetry -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnStartCurrentTarget" Content="▶ START SRT" Background="#1B5E20" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnStartCurrentTarget_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <Button x:Name="BtnStopCurrentTarget" Content="⏹ STOP SRT" Background="#B71C1C" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" IsEnabled="False" Click="BtnStopCurrentTarget_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Ellipse x:Name="LedCurrentTargetStatus" Width="10" Height="10" Fill="#757575" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtCurrentTargetStatus" Text="STOPPED" FontSize="12" FontWeight="Bold" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Mini HUD Telemetry of this target -->
                                        <Border Grid.Column="2" Background="#0F1215" BorderBrush="#22252A" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCurrentTargetHud" Text="RTT: -- ms | Loss: 0.0% | Bitrate: 0.0 Mbps" FontFamily="Consolas, Monospace" FontSize="11" FontWeight="SemiBold" Foreground="#00FFCC" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ════════════════════════════════════════════════════
                                     1. SRT PROTOCOL & AES SECURITY (ĐỘC LẬP TỪNG LUỒNG)
                                     ════════════════════════════════════════════════════ -->
                                <Border Style="{StaticResource DarkCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="1. SRT PROTOCOL, LATENCY &amp; AES SECURITY" FontWeight="Bold" FontSize="12" Foreground="#007ACC" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="SRT Connection Mode:" Style="{StaticResource HeaderLabelStyle}"/>
                                                <ComboBox x:Name="CmbSrtMode">
                                                    <ComboBoxItem Content="Caller (Connect to Studio)" IsSelected="True"/>
                                                    <ComboBoxItem Content="Listener (Wait for Incoming)"/>
                                                    <ComboBoxItem Content="Rendezvous (P2P Firewall Traversal)"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="SRT Stream ID (Optional for Caller Routing):" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtSrtStreamId" Text="live/cam1/feed"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Divider line -->
                                        <Border Height="1" Background="#333338" Margin="0,2,0,8"/>

                                        <!-- Latency Settings for this target (Độ trễ truyền dẫn) -->
                                        <Grid Margin="0,0,0,6">
                                            <CheckBox x:Name="ChkAutoLatency" Content="Auto Latency (3 x RTT)" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" HorizontalAlignment="Right" Checked="ChkAutoLatency_Changed" Unchecked="ChkAutoLatency_Changed"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Configured Latency (ms):" Style="{StaticResource HeaderLabelStyle}"/>
                                                <TextBox x:Name="TxtManualLatency" Text="120" IsEnabled="True"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Calculated Auto Latency:" Style="{StaticResource HeaderLabelStyle}"/>
                                                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Height="30" Padding="8,4">
                                                    <TextBlock x:Name="TxtCalculatedLatency" Text="120 ms (3 x 40ms RTT)" FontSize="12" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Divider line -->
                                        <Border Height="1" Background="#333338" Margin="0,2,0,8"/>

                                        <!-- SRT Encryption Section -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="SRT ENCRYPTION (AES SECURITY)" FontWeight="Bold" FontSize="11.5" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ChkEnableEncryption" Content="Enable Encryption" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" HorizontalAlignment="Right" Checked="ChkEnableEncryption_Changed" Unchecked="ChkEnableEncryption_Changed"/>
                                        </Grid>

                                        <StackPanel x:Name="PnlEncryptionConfig" Visibility="Collapsed">
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Passphrase (10 - 79 characters):" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <PasswordBox x:Name="TxtSrtPassphrase" Password="BroadcastKey2026!" Background="#252526" Foreground="White" BorderBrush="#3F3F46" Height="30" Padding="6,4" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="Key Length:" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <ComboBox x:Name="CmbKeyLength">
                                                        <ComboBoxItem Content="128-bit / 16 bytes"/>
                                                        <ComboBoxItem Content="192-bit / 24 bytes"/>
                                                        <ComboBoxItem Content="256-bit / 32 bytes (Top Secret)" IsSelected="True"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="* Both Sender and Receiver must share the exact same passphrase and key length." FontSize="10" Foreground="#FFA726" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ════════════════════════════════════════════════════
                                     2. GROUP SOCKET & NETWORK ENDPOINT
                                     (ĐỘC LẬP TỪNG LUỒNG)
                                     ════════════════════════════════════════════════════ -->
                                <Border Style="{StaticResource DarkCardBorderStyle}" BorderBrush="#00E5FF" BorderThickness="1.5">
                                    <StackPanel>
                                        <!-- Header & Toggle SMPTE 2022-7 -->
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🛡️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="2. GROUP SOCKET" FontWeight="Bold" FontSize="12.5" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <CheckBox x:Name="ChkGroupSocket" 
                                                      Content="⚪ SMPTE 2022-7: TẮT" 
                                                      Style="{StaticResource ToggleSwitchStyle}" 
                                                      HorizontalAlignment="Right" 
                                                      FontWeight="SemiBold"
                                                      Foreground="#B2EBF2"
                                                      Checked="ChkGroupSocket_Changed" 
                                                      Unchecked="ChkGroupSocket_Changed"/>
                                        </Grid>

                                        <!-- 1. KHI TOGGLE TẮT: ĐƯỜNG TRUYỀN ĐƠN TIÊU CHUẨN (SINGLE SOCKET ENDPOINT) -->
                                        <StackPanel x:Name="PnlSingleStreamConfig" Visibility="Visible">
                                            <Border Background="#161E28" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="CHẾ ĐỘ TRUYỀN ĐƠN" FontWeight="Bold" FontSize="11" Foreground="#00D2FF"/>
                                                        </StackPanel>
                                                        <Border Background="#004D80" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                                            <TextBlock Text="SINGLE LINK" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Remote IP Address / Host:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtSrtIp" Text="127.0.0.1" TextChanged="TxtTargetEndpoint_TextChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                            <TextBlock Text="Port (UDP):" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtSrtPort" Text="9000" TextChanged="TxtTargetEndpoint_TextChanged"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Card mạng nguồn (Source NIC) -->
                                                    <StackPanel Margin="0,0,0,2">
                                                        <TextBlock Text="Card Mạng Nguồn (Source NIC Binding):" Style="{StaticResource HeaderLabelStyle}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox x:Name="CmbSingleSourceNic" Grid.Column="0" Margin="0,0,6,0"/>
                                                            <Button x:Name="BtnScanSingleNic" Grid.Column="1" Content="🔄 Quét NIC" Style="{StaticResource ActionButtonStyle}" Click="BtnScanNic_Click"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 2. KHI TOGGLE BẬT: PANEL CẤU HÌNH SMPTE 2022-7 GROUP SOCKET -->
                                        <StackPanel x:Name="PnlGroupSocketConfig" Visibility="Collapsed">

                                            <!-- Group Redundancy Mode & Differential Delay -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Cơ Chế Group Socket:" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <ComboBox x:Name="CmbGroupType" SelectionChanged="CmbGroupType_SelectionChanged">
                                                        <ComboBoxItem Content="Broadcast (SMPTE 2022-7 Hitless Redundancy)" IsSelected="True"/>
                                                        <ComboBoxItem Content="Backup (Active / Standby Link Failover)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Bù Trễ Vi Sai (Differential Delay Buffer):" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="TxtDifferentialDelay" Text="50" Grid.Column="0" VerticalContentAlignment="Center"/>
                                                        <TextBlock Text="ms" Grid.Column="1" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Member Socket 1: Path A (Primary) -->
                                            <Border Background="#1A2228" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="LedMemberA" Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                                                            <TextBlock Text="MEMBER #1: PATH A (PRIMARY LINK)" FontWeight="Bold" FontSize="11" Foreground="#00E676"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="TxtMemberAStatus" Text="Ready / Live" FontSize="10" FontWeight="SemiBold" Foreground="#81C784" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="Host / IP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtMemberAHost" Text="127.0.0.1" TextChanged="TxtTargetEndpoint_TextChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                            <TextBlock Text="Port UDP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtMemberAPort" Text="9000" TextChanged="TxtTargetEndpoint_TextChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                                            <TextBlock Text="Card Mạng Nguồn (NIC):" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <ComboBox x:Name="CmbMemberANic"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                                            <Button x:Name="BtnScanMemberANic" Content="🔄 Quét NIC" Style="{StaticResource ActionButtonStyle}" Click="BtnScanNic_Click" ToolTip="Quét lại danh sách Card mạng"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Member Socket 2: Path B (Secondary Redundant / 4G/5G) -->
                                            <Border Background="#221E28" BorderBrush="#9C27B0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="LedMemberB" Width="8" Height="8" Fill="#FFC107" Margin="0,0,6,0"/>
                                                            <TextBlock Text="MEMBER #2: PATH B (SECONDARY REDUNDANCY)" FontWeight="Bold" FontSize="11" Foreground="#BA68C8"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="TxtMemberBStatus" Text="Armed / Auto-Connect" FontSize="10" FontWeight="SemiBold" Foreground="#FFD54F" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="Host / IP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtMemberBHost" Text="127.0.0.1" TextChanged="TxtTargetEndpoint_TextChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                            <TextBlock Text="Port UDP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtMemberBPort" Text="9002" TextChanged="TxtTargetEndpoint_TextChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                                            <TextBlock Text="Card Mạng Nguồn (NIC):" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <ComboBox x:Name="CmbMemberBNic"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                                            <Button x:Name="BtnScanMemberBNic" Content="🔄 Quét NIC" Style="{StaticResource ActionButtonStyle}" Click="BtnScanNic_Click" ToolTip="Quét lại danh sách Card mạng"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Dynamic Member Sockets Container -->
                                            <StackPanel x:Name="StackDynamicMembers"/>

                                            <!-- Dynamic Add Member Tool -->
                                            <Border Background="#16181C" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Gắn Thêm Member Socket Mới (Tự Động Kết Nối Vào Phiên Đang Chạy):" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF" Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="Tên Member:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtNewMemberName" Text="Path C (Backup)"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                            <TextBlock Text="Host / IP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtNewMemberHost" Text="127.0.0.1"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                                            <TextBlock Text="Port UDP:" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <TextBox x:Name="TxtNewMemberPort" Text="9004"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                                            <TextBlock Text="Card Mạng Nguồn (NIC):" Style="{StaticResource HeaderLabelStyle}"/>
                                                            <ComboBox x:Name="CmbNewMemberNic"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Button x:Name="BtnAddGroupMember" Content="＋ Gắn Member Socket Này Vào Phiên Đang Phát (Non-Disruptive)" Click="BtnAddGroupMember_Click" Style="{StaticResource ActionButtonStyle}" Height="28" Background="#0D47A1" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Live Telemetry Status Banner -->
                                            <Border Background="#101F18" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock x:Name="TxtGroupProtectionStatus" Text="🛡️ SMPTE 2022-7: ARMED (100% Hitless Protection - 2 Links Active)" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                                                        <TextBlock x:Name="TxtGroupStatsDetail" Text="Path A: 0 pkts | Path B: 0 pkts | Duplicates: 0 | Recovered: 0" FontSize="10" Foreground="#81C784" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#1B5E20" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtGroupLinkCount" Text="2 Links" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ════════════════════════════════════════════════════
                                     🎛️ SHARED MASTER VIDEO / AUDIO ENCODER CONFIGURATION
                                     (HỆ THỐNG MÃ HÓA PHẦN CỨNG DÙNG CHUNG - SINGLE ENCODE)
                                     ════════════════════════════════════════════════════ -->
                                <Border Style="{StaticResource DarkCardBorderStyle}" BorderBrush="#3F51B5" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎛️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CODEC VIDEO / AUDIO" FontWeight="Bold" FontSize="12" Foreground="#8C9EFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#283593" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="DÙNG CHUNG TẤT CẢ LUỒNG" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>

                                        <!-- Video Pipeline Mode & Video Compression Codec -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Video Pipeline Mode:" Style="{StaticResource HeaderLabelStyle}"/>
                                                <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RbEncoderPipe" Grid.Column="0" Content="🎛️ Encoder Pipe" GroupName="VideoPipelineMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="VideoPipelineMode_Changed" Unchecked="VideoPipelineMode_Changed"/>
                                                        <RadioButton x:Name="RbPassthrough" Grid.Column="1" Content="⚡ Passthrough" GroupName="VideoPipelineMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="False" Checked="VideoPipelineMode_Changed" Unchecked="VideoPipelineMode_Changed"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
