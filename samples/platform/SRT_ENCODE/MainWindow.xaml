                                                    <ComboBoxItem Content="59.94 FPS (Broadcast NTSC Reference)"/>
                                                    <ComboBoxItem Content="50.00 FPS (Broadcast PAL Reference)"/>
                                                    <ComboBoxItem Content="30.00 FPS (Standard Web / Streaming)"/>
                                                    <ComboBoxItem Content="29.97 FPS (Standard NTSC)"/>
                                                    <ComboBoxItem Content="25.00 FPS (Standard PAL)" IsSelected="True"/>
                                                    <ComboBoxItem Content="24.00 FPS (Cinema Film 24p)"/>
