                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Source Option 4 Frame: Colorbar & Test Signal (Default: Collapsed) -->
                                <Border x:Name="CardColorbarConfig" Style="{StaticResource DarkCardBorderStyle}" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎨 COLORBAR &amp; SMPTE TEST GENERATOR" FontWeight="Bold" FontSize="12" Foreground="#007ACC"/>
                                                <Border Background="#388E3C" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                                    <TextBlock Text="SMPTE PATTERN" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
