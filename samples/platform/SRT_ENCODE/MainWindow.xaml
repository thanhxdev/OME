                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAudioPeakSummary" Text="Peak: SILENT" HorizontalAlignment="Right" FontSize="9.5" FontWeight="SemiBold" Foreground="#4EC9B0" Visibility="Collapsed"/>
                                </Grid>

                                <!-- VU Channels with dB Scale Ruler -->
                                <StackPanel Orientation="Horizontal">
                                    <!-- Vertical dB Scale Legend -->
                                    <Grid Height="65" Margin="0,8,4,14" VerticalAlignment="Bottom">
