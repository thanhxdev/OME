<Window x:Class="SRT_ENCODE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        xmlns:local="clr-namespace:SRT_ENCODE"
        mc:Ignorable="d"
        Title="Encoder - SRT Professional Transmitter v2.0"
        Height="720" Width="1180"
        MinHeight="500" MinWidth="850"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Custom Styles -->
        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="DarkCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardBorderStyle" BasedOn="{StaticResource DarkCardBorderStyle}" TargetType="Border"/>

        <!-- Toggle Switch CheckBox Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="44" Height="22" Margin="0,0,10,0">
                                <Border x:Name="Track" Background="#3A3A3C" CornerRadius="11" />
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#E0E0E0" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Radio Button Style for Pipeline Mode Switch -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333338"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Dark Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1C97EA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Style -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="4"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="#CCCCCC" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#007ACC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Background" Value="#1E1E1E" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2D2D30" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#555555" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Dark ComboBox Style with Dark Popup Dropdown -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E1E1E"
                                            BorderThickness="1"
                                            BorderBrush="#007ACC"
                                            CornerRadius="4"
                                            Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Default Button Style across Application -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#22252A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2F3238"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Icon-Only Button Style (Transparent with subtle hover) -->
        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Slim Broadcast Mixer Fader Style (Nhỏ, mảnh) ─── -->
        <Style x:Key="SlimMixerFaderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <!-- Track rãnh fader siêu mảnh 2px -->
                            <Border Width="2" Background="#161618" BorderBrush="#35353C" BorderThickness="1" CornerRadius="1" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Width="18" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Đầu trượt Fader Cap nhỏ mảnh, chuyên nghiệp -->
                                                <Border Width="14" Height="8" Background="#33343A" BorderBrush="#686B75" BorderThickness="1" CornerRadius="2" Cursor="SizeNS">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                                                    </Border.Effect>
                                                    <Rectangle Width="8" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Slim Master Program Bus Fader Style (Nhỏ, mảnh với vạch xanh) ─── -->
        <Style x:Key="SlimMixerMasterFaderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <!-- Track rãnh fader siêu mảnh 2px -->
                            <Border Width="2" Background="#161618" BorderBrush="#35353C" BorderThickness="1" CornerRadius="1" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Width="18" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="15" Height="9" Background="#263238" BorderBrush="#00E676" BorderThickness="1" CornerRadius="2" Cursor="SizeNS">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <Rectangle Width="9" Height="1" Fill="#00E676" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Status Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Main Content (2 Columns) -->
            <RowDefinition Height="*"/>
            <!-- 2: Master Control Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             TOP HEADER & MASTER STATUS BAR
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#007ACC" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                        <TextBlock Text="SRT LIVE" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Encoder" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#2A2A2E" CornerRadius="3" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO v2.0" FontSize="10" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                    </Border>
                </StackPanel>

                <!-- Center: Engine & Transmission Status Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Engine Connection Status -->
                    <Border Background="#252526" CornerRadius="12" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedEngineStatus" Width="9" Height="9" Fill="#F44336" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtEngineStatus" Text="Engine: Disconnected" FontSize="12" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- SRT State Indicator -->
                    <Border Background="#252526" CornerRadius="12" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LedSrtStatus" Width="9" Height="9" Fill="#9E9E9E" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtSrtStatus" Text="SRT: Idle" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- Low Latency Badge (Default: Collapsed/Off) -->
                    <Border x:Name="BadgeLowLatency" Background="#1E3A2F" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,4,0"/>
                            <TextBlock Text="ULL ENABLED (B=0, GOP=1s)" FontSize="11" FontWeight="Bold" Foreground="#81C784"/>
                        </StackPanel>
                    </Border>

                    <!-- NTP Wall-Clock Sync Badge -->
                    <Border x:Name="BadgeNtpSync" Background="#372D1E" BorderBrush="#F57C00" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" Margin="0,0,4,0"/>
                            <TextBlock Text="NTP WALL-CLOCK SYNC" FontSize="11" FontWeight="Bold" Foreground="#FFB74D"/>
                        </StackPanel>
                    </Border>

                    <!-- SMPTE 2022-7 Group Socket Badge -->
                    <Border x:Name="BadgeGroupSocket" Background="#122533" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="12" Padding="8,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtBadgeGroupSocketText" Text="SMPTE 2022-7 (ARMED)" FontSize="11" FontWeight="Bold" Foreground="#00D2FF"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Master UTC Clock -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MASTER UTC:" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="#0A0A0A" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtMasterUtcTime" Text="00:00:00.000" FontFamily="Consolas, Monospace" FontSize="14" FontWeight="Bold" Foreground="#00E676"/>
                    </Border>
                    <Border Background="#141E18" BorderBrush="#00E676" BorderThickness="1" CornerRadius="4" Padding="6,3" ToolTip="SMPTE ST 12-1 Broadcast Timecode (25 fps Frame-Locked)">
                        <TextBlock x:Name="TxtMasterSmpteTime" Text="00:00:00:00" FontFamily="Consolas, Monospace" FontSize="13" FontWeight="Bold" Foreground="#00FFCC"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             MAIN CONTENT AREA (RESPONSIVE AUTO SCALE 2-COLUMN GRID)
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Left: Video Preview & VU Meters & Log (Approx 58%) -->
                <ColumnDefinition Width="6.2*" MinWidth="400"/>
                <ColumnDefinition Width="6"/>
                <!-- Right: Configuration Tabs (Approx 42%) -->
                <ColumnDefinition Width="4.8*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

                <!-- ────────────────────────────────────────────────────────────
                     LEFT COLUMN: PREVIEW SCREEN, AUDIO VU METERS, LOG CONSOLE
                     ──────────────────────────────────────────────────────────── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- Video Preview Screen & HUD & Audio Overlay -->
                        <RowDefinition Height="3.8*" MinHeight="220"/>
                        <!-- Preview Toggles & Monitoring Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Activity Log Console -->
                        <RowDefinition Height="1.2*" MinHeight="100"/>
                    </Grid.RowDefinitions>

                <!-- 1. Video Display Area with DirectX11 Zero-Copy View & Overlay HUD -->
                <Border Grid.Row="0" Background="#000000" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" ClipToBounds="True">
                    <Grid x:Name="PnlMasterProgramBus" ClipToBounds="True">
                        <!-- DirectX 11 Hardware Render View -->
                        <om:OpenMediaVideoView x:Name="ReviewView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- SMPTE RP 219 / EBU / Grid Pattern View (Active when Colorbar source is selected) -->
                        <Viewbox x:Name="ViewboxColorbar" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                            <Grid x:Name="PnlColorbarPattern" Width="1920" Height="1080">
                                <!-- Visual Background Pattern (Rendered by ColorbarEngine) -->
                                <Grid x:Name="PnlColorbarVisualHost" Width="1920" Height="1080"/>

                                <!-- Live Burn-in UTC Timecode & Ident Badge (Center Fixed in XAML) -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D00A0A0E" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="12" Padding="28,16">
                                    <StackPanel HorizontalAlignment="Center">
