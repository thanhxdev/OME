                                                        <ComboBoxItem Content="EBU 100% Color Bars"/>
                                                        <ComboBoxItem Content="Grid Alignment Pattern"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Audio Test Tone:" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <ComboBox x:Name="CmbAudioTone" SelectionChanged="CmbAudioTone_SelectionChanged">
                                                        <ComboBoxItem Content="1 kHz Sine (-18 dBFS)" IsSelected="True"/>
                                                        <ComboBoxItem Content="1 kHz Sine (-20 dBFS)"/>
                                                        <ComboBoxItem Content="400 Hz Tone (GLITS)"/>
                                                        <ComboBoxItem Content="EBU Tone Ident"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="* Live UTC Timecode is automatically burnt directly onto frame &amp; tone phase aligned." FontSize="11" Foreground="#4EC9B0" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ════════════════════════════════════════════════════════════
                                     SIMPLIFIED REALTIME SOURCE STREAM TELEMETRY (FIXED AT BOTTOM)
                                     ════════════════════════════════════════════════════════════ -->
                                <Border Style="{StaticResource DarkCardBorderStyle}" BorderBrush="#2D3139" Background="#14181D" Padding="14,12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <!-- Header Line -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Text="📊 ACTIVE SOURCE TELEMETRY" FontWeight="SemiBold" FontSize="11.5" Foreground="#00E676"/>
                                            <Border x:Name="BadgeSourceLockStatus" Background="#1B5E20" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock x:Name="TxtSourceSignalStatus" Text="● SIGNAL LOCKED" FontSize="9" FontWeight="Normal" Foreground="#69F0AE"/>
