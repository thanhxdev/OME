                                            <CheckBox x:Name="ChkLoopFile" Content="Auto Loop Playback" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ChkLoopFile_Changed" Unchecked="ChkLoopFile_Changed" Margin="0,10,0,0"/>
