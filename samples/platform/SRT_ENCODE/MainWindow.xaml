                        </ScrollViewer>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════
                         TAB 3: ULTRA LOW-LATENCY ENGINE PRESET (DEFAULT: OFF)
                         ════════════════════════════════════════════════════ -->
