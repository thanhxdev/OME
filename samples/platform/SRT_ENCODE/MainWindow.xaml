                                        <CheckBox x:Name="ChkUltraLowLatency" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Checked="ChkUltraLowLatency_Changed" Unchecked="ChkUltraLowLatency_Changed" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Enforcement Parameters Card -->
                                <Border Style="{StaticResource DarkCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ENCODER ENGINE PARAMETERS" FontWeight="Bold" FontSize="12" Foreground="#007ACC" Margin="0,0,0,10"/>

                                        <!-- B-Frames = 2 (Standard when ULL is off) -->
                                        <Grid Margin="0,4">
                                            <TextBlock Text="B-Frames Count:" Style="{StaticResource HeaderLabelStyle}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtBframesVal" Text="2 (Standard B-Frames)" FontWeight="Bold" FontSize="12" Foreground="#FFC107"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Preset Zerolatency -->
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Encoder Tuning Preset:" Style="{StaticResource HeaderLabelStyle}"/>
                                            <ComboBox x:Name="CmbEncoderPreset" Width="220" HorizontalAlignment="Right" IsEnabled="True">
                                                <ComboBoxItem Content="Low-Latency / Zerolatency (P1)"/>
                                                <ComboBoxItem Content="Fast Low-Latency (P2)"/>
                                                <ComboBoxItem Content="Medium Quality (P4)" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- GOP Interval = 2s -->
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Keyframe Interval (GOP):" Style="{StaticResource HeaderLabelStyle}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtGopVal" Text="2.0 Seconds (120 Frames @ 60fps)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Rate Control = CBR -->
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Rate Control Mode:" Style="{StaticResource HeaderLabelStyle}"/>
                                            <ComboBox x:Name="CmbRateControl" Width="220" HorizontalAlignment="Right" IsEnabled="True">
                                                <ComboBoxItem Content="CBR (Constant Bitrate - Default)" IsSelected="True"/>
                                                <ComboBoxItem Content="VBR (Variable Bitrate)"/>
                                                <ComboBoxItem Content="CQP (Constant Quantization)"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Master NTP Sync Toggle -->
                                <Border Background="#261E14" BorderBrush="#F57C00" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Multi-Camera NTP Synchronization" FontWeight="Bold" FontSize="13" Foreground="#FFB74D"/>
                                            <TextBlock Text="Activates SyncToWallClock = true flag &amp; injects SEI metadata timestamps." FontSize="11" Foreground="#FFE0B2" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkNtpSync" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Checked="ChkNtpSync_Changed" Unchecked="ChkNtpSync_Changed" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- ════════════════════════════════════════════════════
                                     📡 TELEMETRY MONITOR (GIÁM SÁT TẬP TRUNG)
                                     ════════════════════════════════════════════════════ -->
                                <Border Style="{StaticResource DarkCardBorderStyle}" BorderBrush="#00E676" BorderThickness="1.2">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="TELEMETRY MONITOR" FontWeight="Bold" FontSize="12" Foreground="#00E676" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkEnableTelemetry" 
                                                      Content="Gửi dữ liệu tới SRT Monitor" 
                                                      Style="{StaticResource ToggleSwitchStyle}" 
                                                      HorizontalAlignment="Right" 
                                                      FontWeight="SemiBold"
                                                      IsChecked="False"
                                                      Checked="ChkEnableTelemetry_Changed" 
                                                      Unchecked="ChkEnableTelemetry_Changed"/>
                                        </Grid>

                                        <StackPanel x:Name="PnlTelemetryConfig" Visibility="Collapsed" Margin="0,4,0,0">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="URL Server Monitor:" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <TextBox x:Name="TxtTelemetryServerUrl" Text="http://127.0.0.1:8088" TextChanged="TelemetryInput_TextChanged"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Tên trạm / Luồng (Node Name):" Style="{StaticResource HeaderLabelStyle}"/>
                                                    <TextBox x:Name="TxtTelemetryNodeName" Text="ENC_CAM_01" TextChanged="TelemetryInput_TextChanged"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Trạng thái gửi nhịp tim -->
                                            <Border Background="#1A201A" BorderBrush="#2E4A2E" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="LedTelemetryPulse" Width="10" Height="10" Fill="#555555" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="TxtTelemetryStatus" Text="⚪ Tắt (Chưa kích hoạt giám sát)" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtTelemetryLastSent" Text="Chu kỳ: 1.0s" FontSize="10.5" Foreground="#666666" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- NTP Parameters -->
                                <Border Style="{StaticResource DarkCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="NTP SERVER CONFIGURATION" FontWeight="Bold" FontSize="12" Foreground="#007ACC" Margin="0,0,0,10"/>

                                        <TextBlock Text="NTP Time Server Host:" Style="{StaticResource HeaderLabelStyle}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtNtpServer" Grid.Column="0" Text="time.google.com" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="📡 Sync Now" Style="{StaticResource ActionButtonStyle}" Click="BtnSyncNtp_Click"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <TextBlock Text="NTP Wall-Clock Offset:" Style="{StaticResource HeaderLabelStyle}"/>
                                            <TextBlock x:Name="TxtNtpOffset" Text="Disabled (Free-Run)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#888888"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <TextBlock Text="SEI Metadata Embedding:" Style="{StaticResource HeaderLabelStyle}"/>
                                            <TextBlock x:Name="TxtSeiStatus" Text="SMPTE 12M / MISB 0601 Timecode" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#4EC9B0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
             BOTTOM MASTER ACTION & CONTROL BAR
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#161616" BorderBrush="#2D2D30" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Stream Destination Summary -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Metrics & Counters -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Master Start / Stop Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#222222" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TARGET: " FontWeight="Bold" FontSize="11" Foreground="#888888"/>
                            <TextBlock x:Name="TxtTargetSummary" Text="SRT Caller -> 127.0.0.1:9000" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#222222" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CODEC: " FontWeight="Bold" FontSize="11" Foreground="#888888"/>
                            <TextBlock x:Name="TxtCodecSummary" Text="H.264 @ 6,000 kbps (ULL B=0)" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center Counters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="DURATION:" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtSessionDuration" Text="00:00:00" FontFamily="Consolas, Monospace" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBlock Text="SENT:" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtTotalBytesSent" Text="0.00 MB" FontFamily="Consolas, Monospace" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- START SRT TRANSMISSION -->
                    <Button x:Name="BtnStartStreaming" Content="🚀 START TRANSMISSION (SRT)" Background="#2E7D32" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnStartStreaming_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- STOP TRANSMISSION -->
                    <Button x:Name="BtnStopStreaming" Content="⏹ STOP" Background="#C62828" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="14,6" Cursor="Hand" IsEnabled="False" Click="BtnStopStreaming_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
