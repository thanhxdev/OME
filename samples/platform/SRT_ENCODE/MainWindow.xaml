                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Source Option 2 Frame: NDI Input (Default: Collapsed) -->
                                <Border x:Name="CardNdiConfig" Style="{StaticResource DarkCardBorderStyle}" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌐 NDI NETWORK LIVE SOURCE CONFIGURATION" FontWeight="Bold" FontSize="12" Foreground="#007ACC"/>
                                                <Border Background="#2E7D32" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                                    <TextBlock Text="IP STREAM" FontSize="9" FontWeight="Bold" Foreground="White"/>
