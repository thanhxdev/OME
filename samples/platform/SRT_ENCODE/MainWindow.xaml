                                    <StackPanel x:Name="ColVu1" Width="13" Margin="0,0,1,0">
                                        <Ellipse x:Name="ClipLed1" Width="6" Height="6" Fill="#2A2A2E" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="VuBar1" Orientation="Vertical" Height="65" Width="8" Minimum="-60" Maximum="0" Value="-60" Foreground="#00E676" Background="#161618" BorderThickness="0"/>
