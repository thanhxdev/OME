                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Background="#90000000" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedLiveInput" Width="8" Height="8" Fill="#00E676" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtActiveSourceBadge" Text="INPUT: FILE (No File Selected)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <!-- Telemetry HUD Overlay (Semi-transparent overlay over video) -->
                        <Border x:Name="OverlayTelemetry" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="#B0121214" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="Visible">
                            <StackPanel Width="230">
                                <TextBlock Text="REAL-TIME SRT TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,6"/>

                                <!-- RTT -->
                                <Grid Margin="0,2">
                                    <TextBlock Text="⏱️ RTT (Latency):" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock x:Name="TxtHudRtt" Text="0 ms" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#00E676"/>
                                </Grid>

                                <!-- Packet Loss -->
                                <Grid Margin="0,2">
                                    <TextBlock Text="📉 Packet Loss:" FontSize="11" Foreground="#CCCCCC"/>
