                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtTargetBitrateInput" Text="6000" Width="80" Height="26" TextAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#00E676" Background="#252526" BorderBrush="#007ACC" BorderThickness="1" Padding="6,2" TextChanged="TxtTargetBitrateInput_TextChanged" VerticalContentAlignment="Center"/>
