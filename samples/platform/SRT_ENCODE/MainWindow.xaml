                                                    Foreground="#FF8A80" 
                                                    BorderBrush="#D32F2F" 
                                                    BorderThickness="1" 
                                                    Height="34" 
                                                    Padding="14,0" 
                                                    FontWeight="Bold" 
                                                    FontSize="12" 
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Gỡ bỏ nguồn video hiện tại (Chỉ hoạt động khi không có luồng truyền)"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Source Option 1 Frame: SDI Input (Default: Collapsed) -->
                                <Border x:Name="CardSdiConfig" Style="{StaticResource DarkCardBorderStyle}" Visibility="Collapsed">
