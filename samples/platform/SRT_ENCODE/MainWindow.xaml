                                                <TextBlock x:Name="TxtActiveSourceTypeBadge" Text="📁 FILE INPUT ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#00E676"/>
                                            </Border>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
