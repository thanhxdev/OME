# ============================================================
# OpenMedia SDK — .editorconfig
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,hpp,cpp,c,cc,cxx}]
indent_size = 4

[*.{cs,csproj,sln}]
indent_size = 4

[*.{cmake,CMakeLists.txt}]
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[Makefile]
indent_style = tab
