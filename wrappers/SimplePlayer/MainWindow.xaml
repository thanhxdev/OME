<Window x:Class="SimplePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:om="clr-namespace:OpenMedia.Platform.Controls.Wpf;assembly=OpenMedia.Platform"
        Title="OpenMedia Broadcast Player" Height="650" Width="900"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video Preview -->
        <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="2" Background="Black" Margin="0,0,0,10">
            <om:OpenMediaVideoView x:Name="VideoView" />
        </Border>

        <!-- Transport Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Open File" Width="80" Margin="5" Padding="5" Click="BtnOpen_Click" Background="#2D2D30" Foreground="White"/>
            <Button Content="Play" Width="80" Margin="5" Padding="5" Click="BtnPlay_Click" Background="#2D2D30" Foreground="White"/>
            <Button Content="Pause" Width="80" Margin="5" Padding="5" Click="BtnPause_Click" Background="#2D2D30" Foreground="White"/>
            <Button Content="Stop" Width="80" Margin="5" Padding="5" Click="BtnStop_Click" Background="#2D2D30" Foreground="White"/>
        </StackPanel>

        <!-- Delay Control Panel Card -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video Delay -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="🎬 Video Delay:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                <Slider x:Name="SliderVideoDelay" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="5000" Value="0" VerticalAlignment="Center" ValueChanged="SliderDelay_ValueChanged" Margin="0,5"/>
                <TextBox x:Name="TxtVideoDelay" Grid.Row="0" Grid.Column="2" Text="{Binding ElementName=SliderVideoDelay, Path=Value, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="10,5,0,5" Background="#3E3E42" Foreground="White" BorderThickness="0" TextAlignment="Center"/>

                <!-- Audio Delay -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="🔊 Audio Delay:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                <Slider x:Name="SliderAudioDelay" Grid.Row="1" Grid.Column="1" Minimum="-2000" Maximum="5000" Value="0" VerticalAlignment="Center" ValueChanged="SliderDelay_ValueChanged" Margin="0,5"/>
                <TextBox x:Name="TxtAudioDelay" Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=SliderAudioDelay, Path=Value, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="10,5,0,5" Background="#3E3E42" Foreground="White" BorderThickness="0" TextAlignment="Center"/>

                <!-- Master Delay -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="⏱️ Master Delay:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                <Slider x:Name="SliderMasterDelay" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10000" Value="0" VerticalAlignment="Center" ValueChanged="SliderDelay_ValueChanged" Margin="0,5"/>
                <TextBox x:Name="TxtMasterDelay" Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=SliderMasterDelay, Path=Value, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="10,5,0,5" Background="#3E3E42" Foreground="White" BorderThickness="0" TextAlignment="Center"/>

                <!-- Indicator & Reset -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock x:Name="TxtEffectiveOffset" Text="📊 Effective Offset = 0 ms" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,20,0"/>
                    <Button Content="Reset Delays" Width="100" Padding="5" Click="BtnReset_Click" Background="#2D2D30" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
